@{
    ViewData["Title"] = "Home";
}

<section class="medicare-hero">
    <div class="row align-items-center">

        <div class="col-lg-8">
            <span class="medicare-label">
                HEALTHCARE MANAGEMENT
            </span>

            <h1 class="display-5 fw-bold mt-3">
                Welcome to MediCare
            </h1>

            <p class="lead mt-3">
                Smarter Care. Seamless Management.
            </p>

            <p class="mt-3">
                A modern hospital management platform
                designed to simplify healthcare operations.
            </p>
        </div>

        <div class="col-lg-4 text-center mt-4 mt-lg-0">
            <div class="medicare-symbol">
                <span>+</span>
            </div>
        </div>

    </div>
</section>

<section class="mt-5">

    <h2 class="fw-bold mb-2">Our System Modules</h2>

    <p class="text-muted mb-4">
        Explore the features planned for MediCare HMS.
    </p>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="medicare-card">
                <h5>Patient Management</h5>
                <p>
                    Manage patient registrations,
                    profiles and medical information.
                </p>
                <span class="badge text-bg-light">
                    Coming Soon
                </span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="medicare-card">
                <h5>Doctor Management</h5>
                <p>
                    Organize doctors, departments
                    and working schedules.
                </p>
                <span class="badge text-bg-light">
                    Coming Soon
                </span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="medicare-card">
                <h5>Appointments</h5>
                <p>
                    Schedule and manage
                    patient appointments.
                </p>
                <span class="badge text-bg-light">
                    Coming Soon
                </span>
            </div>
        </div>

    </div>

</section>