@model MediCare.Web.ViewModels.DoctorProfileViewModel
@{ ViewData["Title"] = "Doctor Profile"; var doctor = Model.Doctor; }
<div class="py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div><h1 class="fw-bold">Dr. @doctor.FirstName @doctor.LastName</h1><p class="text-muted">@doctor.RegistrationNumber · @doctor.Specialization</p></div>
        <div class="d-flex gap-2"><a asp-action="Index" class="btn btn-outline-secondary">Back to Doctors</a>
        @if (User.IsInRole("Administrator"))
        {
            <a asp-action="Edit" asp-route-id="@doctor.Id" class="btn btn-primary">Edit Doctor</a>
            <a asp-controller="DoctorSchedules" asp-action="Index" asp-route-doctorId="@doctor.Id" class="btn btn-outline-primary">Manage Schedules</a>
        }</div>
    </div>
    <div class="card border-0 shadow-sm rounded-4 mb-4"><div class="card-body p-4">
        <h2 class="h5">Professional and Contact Information</h2>
        <dl class="row mt-3">
            <dt class="col-md-3">Department</dt><dd class="col-md-9">@doctor.Department.Name</dd>
            <dt class="col-md-3">Qualifications</dt><dd class="col-md-9 text-break" style="white-space: pre-line">@doctor.Qualifications</dd>
            <dt class="col-md-3">Specialization</dt><dd class="col-md-9">@doctor.Specialization</dd>
            <dt class="col-md-3">Email</dt><dd class="col-md-9">@(doctor.Email ?? "Not provided")</dd>
            <dt class="col-md-3">Phone</dt><dd class="col-md-9">@(doctor.PhoneNumber ?? "Not provided")</dd>
            <dt class="col-md-3">Status</dt><dd class="col-md-9"><span class="badge @(doctor.IsActive ? "bg-success" : "bg-secondary")">@(doctor.IsActive ? "Active" : "Inactive")</span></dd>
            @if (User.IsInRole("Administrator"))
            {
                <dt class="col-md-3">Sign-in account</dt><dd class="col-md-9">@(doctor.IdentityUserId == null ? "Not linked" : "Linked to an existing Doctor account")</dd>
            }
        </dl>
    </div></div>
    <div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4">
        <h2 class="h5">Weekly Availability</h2><p class="text-muted">Times are in Sri Lanka time (Asia/Colombo). Availability does not indicate appointment bookings.</p>
        @if (!doctor.IsActive) { <div class="alert alert-warning">This doctor is inactive. Schedules are retained but the doctor is unavailable.</div> }
        <div class="table-responsive"><table class="table"><thead><tr><th>Day</th><th>From</th><th>Until</th></tr></thead><tbody>
        @foreach (var schedule in Model.Schedules)
        { <tr><td>@schedule.DayOfWeek</td><td>@schedule.StartTime.ToString("HH:mm")</td><td>@schedule.EndTime.ToString("HH:mm")</td></tr> }
        @if (Model.Schedules.Count == 0) { <tr><td colspan="3">No active working schedules have been published.</td></tr> }
        </tbody></table></div>
    </div></div>
</div>
