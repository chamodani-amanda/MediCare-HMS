@model List<MediCare.Web.Models.BillingPrice>
@using MediCare.Web.Services
@{var service=(MediCare.Web.Models.BillingService)ViewBag.Service;ViewData["Title"]="Price history";}
<h1>@service.Code — @service.Name</h1><p>Immutable price history, latest 200 entries. Times are Asia/Colombo. Leave effective date and time blank to use the current time. Prices cannot be backdated.</p>
@if(service.IsActive){<form asp-action="Price" method="post" class="row g-3 mb-4"><input type="hidden" name="ServiceId" value="@service.Id"/><div class="col-md-3"><label class="form-label" for="price">Unit price (LKR)</label><input id="price" name="UnitPrice" type="number" min="0" max="999999999.99" step="0.01" required class="form-control"/></div><div class="col-md-3"><label class="form-label" for="date">Effective date</label><input id="date" name="EffectiveDate" type="date" class="form-control"/></div><div class="col-md-3"><label class="form-label" for="time">Effective time</label><input id="time" name="EffectiveTime" type="time" class="form-control"/></div><div class="col-md-3 align-self-end"><button class="btn btn-primary">Add price</button></div></form>}
<div class="table-responsive"><table class="table"><thead><tr><th>Effective time</th><th>Unit price (LKR)</th><th>Recorded time</th><th>Actor</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@HospitalTime.Local(p.EffectiveAtUtc).ToString("yyyy-MM-dd HH:mm:ss")</td><td>@p.UnitPrice.ToString("N2")</td><td>@HospitalTime.Local(p.CreatedAtUtc).ToString("yyyy-MM-dd HH:mm:ss")</td><td>@p.ActorUserId</td></tr>}</tbody></table></div><a asp-action="Index">Back to catalogue</a>
