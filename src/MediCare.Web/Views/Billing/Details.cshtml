@model MediCare.Web.ViewModels.InvoiceDetails
@using MediCare.Web.Models
@using MediCare.Web.Services
@{ViewData["Title"]="Invoice";}
<div class="d-print-none d-flex flex-wrap gap-2 mb-3"><a class="btn btn-outline-secondary" asp-action="Invoices">Invoices</a><button class="btn btn-outline-secondary" type="button" onclick="window.print()">Print</button>@if(Model.Invoice.State!=InvoiceState.Draft){<a class="btn btn-outline-primary" asp-action="Pdf" asp-route-id="@Model.Invoice.Id">Download PDF</a>}</div>
<h1>MediCare invoice @Model.Invoice.DisplayNumber</h1><p>@Model.PatientNumber — @Model.PatientName</p><p>Status: <strong>@BillingRules.PaymentStatus(Model.Invoice,Model.Paid)</strong> · Created @HospitalTime.Local(Model.Invoice.CreatedAtUtc).ToString("yyyy-MM-dd HH:mm") (Asia/Colombo)</p>
@if(Model.Invoice.IssuedAtUtc.HasValue){<p>Issued: @HospitalTime.Local(Model.Invoice.IssuedAtUtc.Value).ToString("yyyy-MM-dd HH:mm")</p>}
@if(Model.Invoice.State==InvoiceState.Voided){<div class="alert alert-warning">VOIDED: @Model.Invoice.VoidReason</div>}
<div class="table-responsive"><table class="table"><thead><tr><th>Description</th><th>Quantity</th><th>Unit price (LKR)</th><th>Total (LKR)</th></tr></thead><tbody>@foreach(var line in Model.Invoice.Lines){<tr><td>@line.Charge.Description</td><td>@line.Charge.Quantity.ToString("0.###")</td><td>@line.Charge.UnitPrice.ToString("N2")</td><td>@line.Charge.Total.ToString("N2")</td></tr>}</tbody></table></div>
<p><strong>Total: LKR @Model.Invoice.Total.ToString("N2") · Net paid: LKR @Model.Paid.ToString("N2") · Outstanding: LKR @Model.Balance.ToString("N2")</strong></p>
<div class="d-print-none">
@if(Model.Invoice.State==InvoiceState.Draft){<a class="btn btn-outline-primary mb-3" asp-action="Draft" asp-route-id="@Model.Invoice.Id">Edit draft</a><form asp-action="Issue" method="post" class="mb-3"><input type="hidden" name="id" value="@Model.Invoice.Id"/><input type="hidden" name="version" value="@Model.Invoice.Version"/><button class="btn btn-primary">Issue invoice</button></form>}
@if(Model.Invoice.State==InvoiceState.Issued){
@if(Model.Balance>0){<a class="btn btn-primary mb-3" asp-action="Pay" asp-route-id="@Model.Invoice.Id">Record payment</a>}
<form asp-action="Void" method="post" class="col-lg-7 mb-4"><input type="hidden" name="id" value="@Model.Invoice.Id"/><input type="hidden" name="version" value="@Model.Invoice.Version"/><label for="voidReason" class="form-label">Void reason (all payments must first be reversed)</label><textarea id="voidReason" name="reason" maxlength="1000" required class="form-control mb-2"></textarea><button class="btn btn-outline-danger">Void invoice</button></form>}
<h2 class="h4">Payment history</h2><div class="table-responsive"><table class="table"><thead><tr><th>Receipt</th><th>Time</th><th>Method</th><th>Amount (LKR)</th><th>Correction</th></tr></thead><tbody>@foreach(var p in Model.Payments){<tr><td><a asp-action="Receipt" asp-route-id="@p.Id">@p.DisplayNumber</a></td><td>@HospitalTime.Local(p.RecordedAtUtc).ToString("yyyy-MM-dd HH:mm")</td><td>@p.Method</td><td>@p.Amount.ToString("N2")</td><td>@if(p.ReversesId==null&&!Model.Payments.Any(r=>r.ReversesId==p.Id)&&Model.Invoice.State==InvoiceState.Issued){<form asp-action="Reverse" method="post"><input type="hidden" name="id" value="@p.Id"/><input type="hidden" name="token" value="@Guid.NewGuid()"/><input type="hidden" name="version" value="@Model.Invoice.Version"/><input name="reason" required maxlength="1000" placeholder="Required reversal reason" aria-label="Reversal reason" class="form-control mb-2"/><button class="btn btn-sm btn-outline-danger">Record full reversal</button></form>}else if(Model.Payments.Any(r=>r.ReversesId==p.Id)){<span>Reversed</span>}else{<span>@p.Reason</span>}</td></tr>}</tbody></table></div></div>
