@model MediCare.Web.ViewModels.BillingPage<MediCare.Web.ViewModels.BillingRow>
@using MediCare.Web.Services
@{ViewData["Title"]="Invoices";}
<h1>Invoices</h1><a class="btn btn-primary mb-3" asp-action="Draft">Create invoice</a>
<form method="get" class="row g-2 mb-3"><div class="col-md-6"><input name="search" value="@Model.Search" placeholder="Patient name or number" aria-label="Search invoices" class="form-control"/></div><div class="col-md-4"><select name="status" class="form-select" aria-label="Invoice status"><option value="">All statuses</option>@foreach(var s in new[]{"Draft","Unpaid","PartiallyPaid","Paid","Voided","Outstanding"}){<option selected="@(Model.Status==s)" value="@s">@s</option>}</select></div><div class="col-md-2"><button class="btn btn-outline-primary">Filter</button></div></form>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Invoice</th><th>Patient</th><th>Status</th><th>Total (LKR)</th><th>Net paid (LKR)</th><th>Balance (LKR)</th></tr></thead><tbody>@foreach(var r in Model.Items){<tr><td><a asp-action="Details" asp-route-id="@r.Invoice.Id">@r.Invoice.DisplayNumber</a></td><td>@r.PatientNumber — @r.PatientName</td><td>@BillingRules.PaymentStatus(r.Invoice,r.Paid)</td><td>@r.Invoice.Total.ToString("N2")</td><td>@r.Paid.ToString("N2")</td><td>@r.Balance.ToString("N2")</td></tr>}</tbody></table></div>
<p>Page @Model.Page of @Math.Max(1,Model.TotalPages)</p>@if(Model.Page>1){<a class="btn btn-outline-secondary" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-page="@(Model.Page-1)">Previous</a>}@if(Model.Page<Model.TotalPages){<a class="btn btn-outline-secondary" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-page="@(Model.Page+1)">Next</a>}
