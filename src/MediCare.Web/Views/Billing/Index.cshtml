@model MediCare.Web.ViewModels.BillingDashboard
@using MediCare.Web.Services
@{ViewData["Title"]="Billing dashboard";}
<h1>Billing and payments</h1><div class="d-flex flex-wrap gap-2 mb-4"><a class="btn btn-primary" asp-action="Charge">New charge</a><a class="btn btn-outline-primary" asp-action="Charges">Patient charges</a><a class="btn btn-outline-primary" asp-action="Invoices">Invoices</a><a class="btn btn-outline-primary" asp-action="Draft">Create invoice</a><a class="btn btn-outline-primary" asp-action="Invoices" asp-route-status="Outstanding">Outstanding balances</a></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card card-body"><h2 class="h6">Outstanding (@Model.OutstandingInvoices invoices)</h2><strong>LKR @Model.Outstanding.ToString("N2")</strong></div></div><div class="col-md-4"><div class="card card-body"><h2 class="h6">Recorded payments in selected period</h2><strong>LKR @Model.RecordedPayments.ToString("N2")</strong></div></div><div class="col-md-4"><div class="card card-body"><h2 class="h6">Recorded reversals in selected period</h2><strong>LKR @Model.Reversals.ToString("N2")</strong></div></div></div>
<h2 class="h4">Payment history</h2><p>Manual records only. No bank or card processing is performed. Times: Asia/Colombo.</p>
<form method="get" class="row g-2 mb-3"><div class="col-md-4"><label asp-for="From" class="form-label"></label><input asp-for="From" type="date" class="form-control"/></div><div class="col-md-4"><label asp-for="To" class="form-label"></label><input asp-for="To" type="date" class="form-control"/></div><div class="col-md-4 align-self-end"><button class="btn btn-outline-primary">Filter payments</button></div></form>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Receipt</th><th>Time</th><th>Method</th><th>Amount (LKR)</th><th>Staff</th></tr></thead><tbody>@foreach(var p in Model.Payments){<tr><td><a asp-action="Receipt" asp-route-id="@p.Id">@p.DisplayNumber</a></td><td>@HospitalTime.Local(p.RecordedAtUtc).ToString("yyyy-MM-dd HH:mm")</td><td>@p.Method</td><td>@p.Amount.ToString("N2")</td><td>@p.ActorUserId</td></tr>}</tbody></table></div>
<p>Page @Model.Page of @Math.Max(1,Model.TotalPages)</p>@if(Model.Page>1){<a class="btn btn-outline-secondary" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-page="@(Model.Page-1)">Previous</a>}@if(Model.Page<Model.TotalPages){<a class="btn btn-outline-secondary" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-page="@(Model.Page+1)">Next</a>}
