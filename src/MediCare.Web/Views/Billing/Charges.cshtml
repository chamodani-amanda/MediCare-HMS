@model MediCare.Web.ViewModels.BillingPage<MediCare.Web.ViewModels.ChargeRow>
@using MediCare.Web.Services
@{ViewData["Title"]="Patient charges";}
<h1>Patient charges</h1><p>Charges retain the original configured price and service description. No automatic clinical charges are generated.</p><a class="btn btn-primary mb-3" asp-action="Charge">New charge</a> <a class="btn btn-outline-primary mb-3" asp-action="Draft">Create invoice</a>
<form method="get" class="d-flex gap-2 mb-3"><input name="search" value="@Model.Search" placeholder="Patient or charge description" aria-label="Search charges" class="form-control"/><button class="btn btn-outline-primary">Search</button></form>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Patient</th><th>Charge and source</th><th>Quantity</th><th>Unit price (LKR)</th><th>Total (LKR)</th><th>Recorded</th></tr></thead><tbody>@foreach(var r in Model.Items){<tr><td>@r.PatientName</td><td>@r.Charge.Description<small class="d-block text-muted text-break">@BillingRules.SourceReference(r.Charge)</small></td><td>@r.Charge.Quantity.ToString("0.###")</td><td>@r.Charge.UnitPrice.ToString("N2")</td><td>@r.Charge.Total.ToString("N2")</td><td>@HospitalTime.Local(r.Charge.CreatedAtUtc).ToString("yyyy-MM-dd HH:mm")</td></tr>}</tbody></table></div>
<p>Page @Model.Page of @Math.Max(1,Model.TotalPages)</p>@if(Model.Page>1){<a class="btn btn-outline-secondary" asp-route-search="@Model.Search" asp-route-page="@(Model.Page-1)">Previous</a>}@if(Model.Page<Model.TotalPages){<a class="btn btn-outline-secondary" asp-route-search="@Model.Search" asp-route-page="@(Model.Page+1)">Next</a>}
