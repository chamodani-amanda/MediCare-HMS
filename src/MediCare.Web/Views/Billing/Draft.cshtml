@model MediCare.Web.ViewModels.InvoiceForm
@{ViewData["Title"]="Draft invoice";}
<h1>Draft invoice</h1><p>Select existing charges. Issuance freezes the invoice; corrections then require the approved void-and-replace workflow.</p>
@if(Model.Id==Guid.Empty){<form method="get" class="d-flex gap-2 mb-3"><input name="search" class="form-control" placeholder="Patient name or number" aria-label="Find patient"/><button class="btn btn-outline-primary">Search</button></form><form method="get" class="d-flex gap-2 mb-4"><select name="patientId" class="form-select" aria-label="Patient"><option value="">Choose patient</option>@foreach(var p in Model.Patients){<option value="@p.Id" selected="@(p.Id==Model.PatientId)">@p.Label</option>}</select><button class="btn btn-outline-primary">Load charges</button></form>}
<form method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="Id" type="hidden"/><input asp-for="Token" type="hidden"/><input asp-for="PatientId" type="hidden"/><input asp-for="Version" type="hidden"/>
<p>Patient: @Model.Patients.FirstOrDefault(p=>p.Id==Model.PatientId)?.Label</p>
<div class="table-responsive"><table class="table"><thead><tr><th>Select</th><th>Charge</th><th>Quantity</th><th>Unit price (LKR)</th><th>Total (LKR)</th></tr></thead><tbody>@foreach(var c in Model.Charges){<tr><td><input type="checkbox" class="form-check-input" name="ChargeIds" value="@c.Id" checked="@Model.ChargeIds.Contains(c.Id)" aria-label="Select @c.Description"/></td><td>@c.Description</td><td>@c.Quantity.ToString("0.###")</td><td>@c.UnitPrice.ToString("N2")</td><td>@c.Total.ToString("N2")</td></tr>}</tbody></table></div><p>Up to 500 available charges displayed.</p><button class="btn btn-primary">Save draft</button> <a asp-action="Invoices" class="btn btn-outline-secondary">Cancel</a></form>
