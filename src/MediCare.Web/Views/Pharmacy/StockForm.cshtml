@model MediCare.Web.ViewModels.StockForm
@{ ViewData["Title"] = Model.BatchId == Guid.Empty ? "Receive Stock" : "Adjust Stock"; }
<div class="py-4"><h1>@ViewData["Title"]</h1><form method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="MedicineId" type="hidden" /><input asp-for="BatchId" type="hidden" /><input asp-for="Token" type="hidden" /><input asp-for="Version" type="hidden" />
@if(Model.BatchId==Guid.Empty){<div class="row g-3"><div class="col-md-6"><label asp-for="BatchNumber" class="form-label"></label><input asp-for="BatchNumber" required class="form-control" /></div><div class="col-md-6"><label asp-for="Supplier" class="form-label"></label><input asp-for="Supplier" required class="form-control" /></div><div class="col-md-6"><label asp-for="ManufacturedOn" class="form-label"></label><input asp-for="ManufacturedOn" type="date" class="form-control" /></div><div class="col-md-6"><label asp-for="ExpiresOn" class="form-label"></label><input asp-for="ExpiresOn" type="date" required class="form-control" /></div></div>}
<div class="my-3"><label asp-for="Quantity" class="form-label">Quantity change (negative to remove stock)</label><input asp-for="Quantity" type="number" step="0.001" required class="form-control" /></div><div class="mb-3"><label asp-for="Reason" class="form-label">Reason / receiving reference</label><textarea asp-for="Reason" maxlength="1000" required class="form-control"></textarea></div><button class="btn btn-primary">Save stock movement</button> <a asp-action="Batches" class="btn btn-outline-secondary">Cancel</a></form></div>
