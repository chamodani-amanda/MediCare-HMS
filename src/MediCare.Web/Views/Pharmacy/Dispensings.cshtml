@model MediCare.Web.ViewModels.PharmacyPage<MediCare.Web.Models.PharmacyDispense>
@{ ViewData["Title"] = "Dispensing History"; }
<div class="py-4"><h1>Dispensing History</h1><partial name="_Navigation" /><div class="table-responsive mt-3"><table class="table"><thead><tr><th>Time (Colombo)</th><th>Dispense / prescription references</th><th>Quantity</th><th>Pharmacist</th><th>Correction</th></tr></thead><tbody>@foreach(var d in Model.Rows){<tr><td>@MediCare.Web.Services.HospitalTime.Local(d.OccurredAtUtc)</td><td>@d.Id<br />@d.PrescriptionId</td><td>@d.Quantity</td><td>@d.ActorUserId</td><td>@if(d.ReversesId==null){<details><summary>Reverse entire issue</summary><form asp-action="Reverse" asp-route-id="@d.Id" method="post"><input name="token" value="@Guid.NewGuid()" type="hidden" /><label>Reason<textarea name="reason" maxlength="1000" required class="form-control"></textarea></label><label class="d-block"><input type="checkbox" name="returnedToQuarantine" value="true" required /> All issued goods returned to quarantine; none returned to saleable stock</label><button class="btn btn-outline-danger btn-sm">Record reversal</button></form></details>}else{<span>Reverses @d.ReversesId · @d.Reason</span>}</td></tr>}</tbody></table></div><partial name="_Paging" model="(Model.Page,Model.Pages,Model.Total,Model.Search,Model.Filter)" /></div>
