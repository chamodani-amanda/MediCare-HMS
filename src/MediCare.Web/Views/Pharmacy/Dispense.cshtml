@model MediCare.Web.ViewModels.DispenseForm
@{ ViewData["Title"] = "Dispense Prescription"; }
@if(Model.Prescription is {} p){<div class="card card-body mt-4"><h2 class="h5">@p.PatientLabel</h2><p>@p.MedicineLabel</p><p>@p.Instructions</p><p>Authorized: @p.Authorized · Issued (net): @p.Dispensed · Remaining: @p.Remaining</p></div>}
<div class="table-responsive mt-3"><table class="table"><caption>Eligible batches in FEFO order</caption><thead><tr><th>Batch</th><th>Expires</th><th>Available</th><th>Exception reference</th></tr></thead><tbody>@foreach(var b in Model.Batches){<tr><td>@b.BatchNumber</td><td>@b.ExpiresOn</td><td>@b.AvailableQuantity</td><td>@b.Id</td></tr>}</tbody></table></div>
<div class="py-4"><h1>Dispense Prescription</h1><p>Confirm the exact prescription in the worklist before issuing. Quantities use its authorized dispensing unit. Batches are selected by earliest expiry, then receiving time.</p><form method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="PrescriptionId" type="hidden" /><input asp-for="Token" type="hidden" /><div class="mb-3"><label asp-for="Quantity" class="form-label">Quantity to issue</label><input asp-for="Quantity" type="number" min="0.001" max="1000000000" step="0.001" class="form-control" required /></div><details class="mb-3"><summary>Documented FEFO exception</summary><label asp-for="ExceptionBatchId" class="form-label">Exact inventory batch reference (optional)</label><input asp-for="ExceptionBatchId" class="form-control" /><label asp-for="ExceptionReason" class="form-label">Required exception reason</label><textarea asp-for="ExceptionReason" maxlength="1000" class="form-control"></textarea></details><button class="btn btn-primary">Confirm dispensing</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form></div>
