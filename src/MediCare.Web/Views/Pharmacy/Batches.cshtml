@model MediCare.Web.ViewModels.PharmacyPage<MediCare.Web.Models.MedicineBatch>
@{ ViewData["Title"] = "Inventory Batches"; }
<div class="py-4"><h1>Inventory Batches</h1><partial name="_Navigation" /><p class="mt-3">Expiry date itself is unavailable. Quantities use the exact catalogue dispensing unit.</p><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Medicine / batch</th><th>Supplier</th><th>Manufactured / expires</th><th>Available</th><th></th></tr></thead><tbody>@foreach(var b in Model.Rows){<tr><td>@b.Medicine.Label<br />@b.BatchNumber</td><td>@b.Supplier</td><td>@b.ManufacturedOn / @b.ExpiresOn</td><td>@b.AvailableQuantity</td><td><a asp-action="Adjust" asp-route-id="@b.Id">Adjust</a> · <a asp-action="History" asp-route-batchId="@b.Id">History</a></td></tr>}</tbody></table></div><partial name="_Paging" model="(Model.Page,Model.Pages,Model.Total,Model.Search,Model.Filter)" /></div>
