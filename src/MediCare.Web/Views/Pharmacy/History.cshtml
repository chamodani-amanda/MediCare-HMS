@model MediCare.Web.ViewModels.PharmacyPage<MediCare.Web.Models.InventoryMovement>
@{ ViewData["Title"] = "Stock History"; }
<div class="py-4"><h1>Stock History</h1><partial name="_Navigation" /><div class="table-responsive mt-3"><table class="table table-striped"><thead><tr><th>Time (Colombo)</th><th>Medicine / batch</th><th>Type</th><th>Quantity</th><th>Reason</th><th>Actor / dispense reference</th></tr></thead><tbody>@foreach(var m in Model.Rows){<tr><td>@MediCare.Web.Services.HospitalTime.Local(m.OccurredAtUtc)</td><td>@m.Batch.Medicine.Label / @m.Batch.BatchNumber</td><td>@m.Kind</td><td>@m.Quantity</td><td>@m.Reason</td><td>@m.ActorUserId<br />@m.DispenseId</td></tr>}</tbody></table></div><p>Quarantine returns do not increase available stock. Physical quarantine disposition is handled separately.</p><partial name="_Paging" model="(Model.Page,Model.Pages,Model.Total,Model.Search,Model.Filter)" /></div>
