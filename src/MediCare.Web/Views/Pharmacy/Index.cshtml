@model MediCare.Web.ViewModels.PharmacyPage<MediCare.Web.ViewModels.PharmacyPrescriptionRow>
@{ ViewData["Title"] = "Pharmacy"; }
<div class="py-4"><h1>Pharmacy</h1><partial name="_Navigation" /><h2 class="h4 mt-4">Eligible prescriptions</h2><p>Latest finalized orders with explicit medicine and quantity authorization only. Draft amendments suspend dispensing until finalized.</p><form method="get" class="d-flex gap-2 mb-3"><input name="search" value="@Model.Search" maxlength="100" placeholder="Patient number or medicine code" aria-label="Search prescriptions" class="form-control" /><button class="btn btn-secondary">Search</button></form>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Patient</th><th>Exact medicine</th><th>Prescriber instructions</th><th>Authorized / issued / remaining</th><th></th></tr></thead><tbody>@foreach(var p in Model.Rows){<tr><td>@p.PatientLabel</td><td>@p.MedicineLabel</td><td>@p.Instructions</td><td>@p.Authorized / @p.Dispensed / @p.Remaining</td><td>@if(p.Remaining>0){<a asp-action="Dispense" asp-route-id="@p.Id">Dispense</a>}</td></tr>}</tbody></table></div><partial name="_Paging" model="(Model.Page,Model.Pages,Model.Total,Model.Search,Model.Filter)" /></div>
