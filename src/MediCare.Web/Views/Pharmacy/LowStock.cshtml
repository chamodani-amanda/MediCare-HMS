@model MediCare.Web.ViewModels.PharmacyPage<MediCare.Web.ViewModels.StockAlertRow>
@{ ViewData["Title"] = "Low Stock"; }
<div class="py-4"><h1>Low Stock</h1><partial name="_Navigation" /><div class="table-responsive mt-3"><table class="table"><thead><tr><th>Medicine</th><th>Unexpired available</th><th>Threshold</th><th></th></tr></thead><tbody>@foreach(var r in Model.Rows){<tr><td>@r.Medicine.Label</td><td>@r.Available</td><td>@r.Medicine.LowStockThreshold</td><td><a asp-action="Receive" asp-route-medicineId="@r.Medicine.Id">Receive stock</a></td></tr>}</tbody></table></div><partial name="_Paging" model="(Model.Page,Model.Pages,Model.Total,Model.Search,Model.Filter)" /></div>
