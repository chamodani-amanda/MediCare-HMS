
@model MediCare.Web.ViewModels.AppointmentReportViewModel

@{
    ViewData["Title"] = "Appointment Report";

    var sriLanka = TimeZoneInfo
        .FindSystemTimeZoneById("Asia/Colombo");
}

<div class="container py-4">

    <div class="d-flex justify-content-between
                align-items-center flex-wrap gap-2 mb-4">

        <div>
            <h1 class="fw-bold">Appointment Report</h1>

            <p class="text-muted">
                Appointment activity and status overview.
                Dates and times use Sri Lanka time.
            </p>
        </div>

        <a asp-controller="Reports"
           asp-action="Index"
           class="btn btn-outline-secondary d-print-none">
            Back to Reports
        </a>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <p class="text-muted">Total</p>
                    <h3>@Model.TotalAppointments</h3>
                </div>
            </div>
        </div>

        <div class="col-md">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <p class="text-muted">Scheduled</p>
                    <h3>@Model.ScheduledAppointments</h3>
                </div>
            </div>
        </div>

        <div class="col-md">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <p class="text-muted">Completed</p>
                    <h3>@Model.CompletedAppointments</h3>
                </div>
            </div>
        </div>

        <div class="col-md">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <p class="text-muted">Cancelled</p>
                    <h3>@Model.CancelledAppointments</h3>
                </div>
            </div>
        </div>

        <div class="col-md">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <p class="text-muted">No-show</p>
                    <h3>@Model.NoShowAppointments</h3>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm border-0 mb-4 d-print-none">
        <div class="card-body p-4">

            <form asp-controller="Reports"
                  asp-action="AppointmentReport"
                  method="get"
                  class="row g-3 align-items-end">

                <div class="col-md-4">
                    <label class="form-label">
                        Patient or Doctor
                    </label>

                    <input type="search"
                           name="search"
                           value="@Model.Search"
                           maxlength="100"
                           class="form-control"
                           placeholder="Name or patient number" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Status</label>

                    <select name="status" class="form-select">
                        @foreach (var value in new[] {
                            "All",
                            "Scheduled",
                            "Completed",
                            "Cancelled",
                            "NoShow"
                        })
                        {
                            <option value="@value"
                                    selected="@(Model.Status == value)">
                                @value
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">From Date</label>

                    <input type="date"
                           name="fromDate"
                           value="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                           class="form-control" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">To Date</label>

                    <input type="date"
                           name="toDate"
                           value="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                           class="form-control" />
                </div>

                <div class="col-md-2">
                    <button type="submit"
                            class="btn btn-primary w-100">
                        Filter
                    </button>
                </div>

                <div class="col-12">
                    <a asp-action="AppointmentReport"
                       class="btn btn-outline-secondary">
                        Clear Filters
                    </a>
                </div>

            </form>

        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <div class="d-flex justify-content-between
                        align-items-center flex-wrap gap-2 mb-3">

                <h5 class="fw-bold mb-0">
                    Appointment Records
                    (@Model.MatchingAppointments)
                </h5>

                <div class="d-flex gap-2 d-print-none">

                    <a asp-action="ExportAppointmentsCsv"
                       asp-route-search="@Model.Search"
                       asp-route-status="@Model.Status"
                       asp-route-fromDate="@Model.FromDate"
                       asp-route-toDate="@Model.ToDate"
                       class="btn btn-outline-success">
                        Export CSV
                    </a>

                    <button type="button"
                            onclick="window.print()"
                            class="btn btn-outline-primary">
                        Print
                    </button>

                </div>

            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Patient Number</th>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var appointment in Model.Appointments)
                        {
                            <tr>
                                <td>@appointment.PatientNumber</td>

                                <td>@appointment.PatientName</td>

                                <td>@appointment.DoctorName</td>

                                <td>
                                    @(TimeZoneInfo.ConvertTimeFromUtc(
                                        appointment.StartAtUtc,
                                        sriLanka).ToString("yyyy-MM-dd HH:mm"))
                                </td>

                                <td>
                                    @(TimeZoneInfo.ConvertTimeFromUtc(
                                        appointment.EndAtUtc,
                                        sriLanka).ToString("yyyy-MM-dd HH:mm"))
                                </td>

                                <td>
                                    @if (appointment.Status ==
                                        MediCare.Web.Models.AppointmentStatus.Completed)
                                    {
                                        <span class="badge bg-success">
                                            Completed
                                        </span>
                                    }
                                    else if (appointment.Status ==
                                        MediCare.Web.Models.AppointmentStatus.Cancelled)
                                    {
                                        <span class="badge bg-danger">
                                            Cancelled
                                        </span>
                                    }
                                    else if (appointment.Status ==
                                        MediCare.Web.Models.AppointmentStatus.NoShow)
                                    {
                                        <span class="badge bg-secondary">
                                            No-show
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">
                                            Scheduled
                                        </span>
                                    }
                                </td>
                            </tr>
                        }

                        @if (Model.Appointments.Count == 0)
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-muted py-4">
                                    No matching appointments found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-between
                            align-items-center mt-3 d-print-none">

                    <span class="text-muted">
                        Page @Model.Page of @Model.TotalPages
                    </span>

                    <div class="d-flex gap-2">

                        @if (Model.Page > 1)
                        {
                            <a asp-action="AppointmentReport"
                               asp-route-search="@Model.Search"
                               asp-route-status="@Model.Status"
                               asp-route-fromDate="@Model.FromDate"
                               asp-route-toDate="@Model.ToDate"
                               asp-route-page="@(Model.Page - 1)"
                               class="btn btn-outline-secondary btn-sm">
                                Previous
                            </a>
                        }

                        @if (Model.Page < Model.TotalPages)
                        {
                            <a asp-action="AppointmentReport"
                               asp-route-search="@Model.Search"
                               asp-route-status="@Model.Status"
                               asp-route-fromDate="@Model.FromDate"
                               asp-route-toDate="@Model.ToDate"
                               asp-route-page="@(Model.Page + 1)"
                               class="btn btn-outline-primary btn-sm">
                                Next
                            </a>
                        }

                    </div>
                </div>
            }

        </div>
    </div>

    <p class="text-muted small mt-3">
        Summary counts follow the search and date filters,
        regardless of selected status.
        Printing includes the current page only.
        CSV exports include all matching records, up to 10,000.
    </p>

</div>
