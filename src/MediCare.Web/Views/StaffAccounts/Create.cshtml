@model MediCare.Web.ViewModels.StaffAccountCreateViewModel

@{
    ViewData["Title"] = "Create Staff Account";
}

<div class="py-4">

    <div class="mb-4">
        <h1 class="fw-bold">Create Staff Account</h1>

        <p class="text-muted">
            Register a new hospital staff login account.
        </p>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <form asp-controller="StaffAccounts"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <h5 class="fw-bold mb-4">
                    Account Information
                </h5>

                <div class="row g-3">

                    <div class="col-md-12">
                        <label asp-for="Email"
                               class="form-label">
                            Staff Email *
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               autocomplete="off"
                               placeholder="staff@medicare.test" />

                        <span asp-validation-for="Email"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Password"
                               class="form-label">
                            Initial Password *
                        </label>

                        <input asp-for="Password"
                               class="form-control"
                               autocomplete="new-password" />

                        <span asp-validation-for="Password"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword"
                               class="form-label">
                            Confirm Password *
                        </label>

                        <input asp-for="ConfirmPassword"
                               class="form-control"
                               autocomplete="new-password" />

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Role"
                               class="form-label">
                            Hospital Role *
                        </label>

                        <select asp-for="Role"
                                class="form-select">

                            <option value="">
                                Select a hospital role
                            </option>

                            @foreach (var role in
                                MediCare.Web.ViewModels
                                    .StaffAccountCreateViewModel
                                    .AssignableRoles)
                            {
                                <option value="@role">@role</option>
                            }

                        </select>

                        <span asp-validation-for="Role"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="alert alert-info mt-4">
                    Development accounts only.
                    Use fictional staff information.
                    Email verification and password
                    recovery will be implemented later.
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a asp-controller="StaffAccounts"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4">
                        Create Account
                    </button>

                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}