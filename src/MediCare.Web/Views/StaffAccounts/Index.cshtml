@model List<MediCare.Web.ViewModels.StaffAccountListItemViewModel>

@{
    ViewData["Title"] = "Staff Accounts";
}

<div class="py-4">

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success">
            @success
        </div>
    }

    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger">
            @error
        </div>
    }

    <div class="mb-4">
        <h1 class="fw-bold">Staff Accounts</h1>
        <p class="text-muted">
            Manage hospital staff login accounts and access.
        </p>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <div class="d-flex justify-content-between
                        align-items-center flex-wrap gap-3 mb-4">

                <h5 class="fw-bold mb-0">
                    Registered Accounts
                </h5>

                <a asp-controller="StaffAccounts"
                   asp-action="Create"
                   class="btn btn-primary">
                    + Create Staff Account
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var account in Model)
                        {
                            <tr>
                                <td>@account.Email</td>

                                <td>
                                    <span class="badge bg-info text-dark">
                                        @account.Roles
                                    </span>
                                </td>

                                <td>
                                    @if (account.IsDeactivated)
                                    {
                                        <span class="badge bg-danger">
                                            Deactivated
                                        </span>
                                    }
                                    else if (account.IsTemporarilyLocked)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Temporarily Locked
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (account.CanManage)
                                    {
                                        @if (account.IsDeactivated)
                                        {
                                            <form asp-controller="StaffAccounts"
                                                  asp-action="Reactivate"
                                                  asp-route-id="@account.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-success">
                                                    Reactivate
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-controller="StaffAccounts"
                                                  asp-action="Deactivate"
                                                  asp-route-id="@account.Id"
                                                  method="post"
                                                  onsubmit="return confirm('Deactivate this staff account?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Deactivate
                                                </button>
                                            </form>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">
                                            Protected
                                        </span>
                                    }

                                    @if (account.CanManage && !account.IsDeactivated)
{
    <a asp-controller="StaffAccounts"
       asp-action="ResetPassword"
       asp-route-id="@account.Id"
       class="btn btn-sm btn-outline-secondary mt-1">
        Reset Password
    </a>
}
                                </td>
                            </tr>
                        }

                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="4"
                                    class="text-center text-muted py-4">
                                    No accounts found.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>
</div>