
@{
    ViewData["Title"] = "Dashboard";

    bool isAdmin = User.IsInRole("Administrator");
    bool isReceptionist = User.IsInRole("Receptionist");
    bool isDoctor = User.IsInRole("Doctor");
    bool isPharmacist = User.IsInRole("Pharmacist");
    bool isLabStaff = User.IsInRole("Laboratory Staff");
    bool isAccountant = User.IsInRole("Accountant");
}

<style>
    /* ========================================
       MEDICARE DASHBOARD - PAGE LAYOUT
       ======================================== */

    body:has(#mc-dashboard-ui) {
        background: #f3f7fc;
        margin-bottom: 0 !important;
    }

    /* Hide shared header/footer on Dashboard only */
    body:has(#mc-dashboard-ui) > header,
    body:has(#mc-dashboard-ui) > footer {
        display: none !important;
    }

    body:has(#mc-dashboard-ui) > .container {
        max-width: none !important;
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    body:has(#mc-dashboard-ui) > .container > main {
        padding: 0 !important;
    }

    #mc-dashboard-ui {
        display: grid;
        grid-template-columns: 240px minmax(0, 1fr);
        min-height: 100dvh;
        color: #193a55;
        font-family: "Segoe UI", Arial, sans-serif;
    }

    #mc-dashboard-ui * {
        box-sizing: border-box;
    }

    #mc-dashboard-ui a {
        text-decoration: none;
    }

    #mc-dashboard-ui svg {
        width: 22px;
        height: 22px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.9;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .mc-icon-sprite {
        position: absolute;
        width: 0;
        height: 0;
        overflow: hidden;
    }

    /* ========================================
       LEFT SIDEBAR
       ======================================== */

    .mc-sidebar {
        position: sticky;
        top: 0;
        height: 100dvh;

        display: flex;
        flex-direction: column;

        padding: 28px 16px;

        background: linear-gradient(
            165deg,
            #085b65,
            #073d56 55%,
            #052d49
        );

        color: white;
        overflow-y: auto;
    }

    .mc-sidebar-brand {
        display: flex;
        justify-content: center;
        align-items: center;

        padding: 13px 10px;
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 12px 25px rgba(0,0,0,0.15);
    }

    .mc-sidebar-brand img {
        width: 175px;
        max-width: 100%;
        max-height: 65px;
        height: auto;
        object-fit: contain;
    }

    .mc-sidebar-heading {
        margin: 35px 12px 14px;

        color: #a7d7e0;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 2px;
    }

    .mc-sidebar-nav {
        display: flex;
        flex-direction: column;
        gap: 9px;
    }

    .mc-sidebar-link {
        display: flex;
        align-items: center;
        gap: 13px;

        padding: 13px 15px;
        min-height: 50px;

        color: #d8eef2;
        border-radius: 13px;

        font-size: 14px;
        font-weight: 650;

        transition: background .2s, transform .2s;
    }

    .mc-sidebar-link:hover,
    .mc-sidebar-link:focus-visible {
        background: rgba(255,255,255,0.14);
        color: white;
        transform: translateX(3px);
    }

    .mc-sidebar-link.active {
        color: white;

        background: linear-gradient(
            120deg,
            #0ab5a9,
            #087f8e
        );

        box-shadow: 0 6px 18px rgba(0,0,0,0.16);
    }

    .mc-sidebar-bottom {
        margin-top: auto;
        padding: 18px 12px;

        background: rgba(255,255,255,0.09);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 15px;

        text-align: center;
        color: #d3f1f2;
        font-size: 12px;
        line-height: 1.7;
    }

    .mc-sidebar-bottom strong {
        display: block;
        font-size: 15px;
        color: white;
    }

    /* ========================================
       RIGHT WORKSPACE
       ======================================== */

    .mc-workspace {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .mc-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;

        min-height: 75px;
        padding: 12px 30px;

        background: white;
        border-bottom: 1px solid #e2eaf3;
    }

    .mc-topbar-title {
        display: flex;
        align-items: center;
        gap: 10px;

        color: #173750;
        font-size: 17px;
        font-weight: 800;
    }

    .mc-status-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #0cad9f;
        box-shadow: 0 0 0 5px #def6f2;
    }

    .mc-topbar-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 10px;
    }

    .mc-user-email {
        color: #61748a;
        font-size: 13px;
        margin-right: 8px;
        overflow-wrap: anywhere;
    }

    .mc-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        padding: 11px 17px;
        border: 0;
        border-radius: 11px;

        color: #fff !important;
        font-weight: 700;
        font-size: 13px;
        cursor: pointer;

        transition: transform .2s, box-shadow .2s, filter .2s;
    }

    .mc-action-btn:hover {
        color: white !important;
        transform: translateY(-2px);
        filter: brightness(1.08);
        box-shadow: 0 7px 18px rgba(30,50,70,.18);
    }

    .mc-password-btn {
        background: linear-gradient(125deg,#8173e2,#5b51bc);
    }

    .mc-logout-btn {
        background: linear-gradient(125deg,#f46c7b,#d63c55);
    }

    /* ========================================
       MAIN DASHBOARD CONTENT
       ======================================== */

    .mc-dashboard-content {
        width: 100%;
        max-width: 1600px;
        margin: 0 auto;
        padding: 25px 30px 36px;
        flex: 1;
    }

    /* Hospital hero banner */

    .mc-hero {
        position: relative;
        min-height: 205px;

        display: flex;
        align-items: center;

        overflow: hidden;
        border-radius: 22px;

        background: linear-gradient(
            115deg,
            #d9f7f6,
            #e2f2ff
        );

        border: 1px solid #d1e7ef;
        box-shadow: 0 8px 23px rgba(35,70,100,.07);
    }

    .mc-hero-image {
        position: absolute;
        inset: 0 0 0 auto;
        width: 57%;

        background:
            linear-gradient(
                90deg,
                #def6f9 0%,
                rgba(222,246,249,.35) 50%,
                transparent 100%
            ),
            url('/images/medicare-dashboard-hero.jpg')
            center center / cover no-repeat;
    }

    .mc-hero-copy {
        position: relative;
        z-index: 1;

        padding: 30px 36px;
        max-width: 66%;
    }

    .mc-hero-kicker {
        color: #0a8288;
        font-size: 11px;
        font-weight: 900;
        letter-spacing: 1.7px;
        margin-bottom: 10px;
    }

    .mc-hero h1 {
        font-size: clamp(29px, 2.8vw, 43px);
        font-weight: 850;
        letter-spacing: -1px;
        line-height: 1.15;
        color: #123b58;
        margin-bottom: 12px;
    }

    .mc-hero-description {
        color: #456579;
        font-size: 16px;
        margin-bottom: 12px;
    }

    .mc-hero-tagline {
        color: #087d7b;
        font-size: 15px;
        font-weight: 800;
        font-style: italic;
    }

    /* Section heading */

    .mc-section-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;

        margin: 27px 0 19px;
    }

    .mc-section-title h2 {
        font-size: 26px;
        font-weight: 850;
        color: #163b58;
        margin-bottom: 5px;
    }

    .mc-section-title p {
        color: #718397;
        font-size: 14px;
        margin-bottom: 0;
    }

    .mc-section-count {
        padding: 9px 14px;
        border-radius: 30px;
        border: 1px solid #d5e4ef;

        color: #59728b;
        background: #ffffff;
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
    }

    /* ========================================
       SIX MANAGEMENT CARDS
       ======================================== */

    .mc-module-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: 20px;
        align-items: start;
    }

    .mc-module {
        --accent: #0ba99c;
        --accent-dark: #087b83;
        --tint: #e4f8f5;
        --icon-bg: #d0f2ed;

        background: linear-gradient(
            150deg,
            #ffffff 55%,
            var(--tint)
        );

        border: 1px solid #dce6f0;
        border-top: 5px solid var(--accent);
        border-radius: 20px;

        overflow: hidden;
        box-shadow: 0 6px 20px rgba(29,65,95,.07);

        transition: transform .2s, box-shadow .2s;
    }

    .mc-module:hover {
        transform: translateY(-3px);
        box-shadow: 0 13px 27px rgba(29,65,95,.13);
    }

    .mc-module[open] {
        box-shadow: 0 15px 32px rgba(29,65,95,.15);
    }

    .mc-module summary {
        display: flex;
        flex-direction: column;
        justify-content: space-between;

        min-height: 192px;
        padding: 23px;

        list-style: none;
        cursor: pointer;
    }

    .mc-module summary::-webkit-details-marker {
        display: none;
    }

    .mc-module summary::marker {
        content: "";
    }

    .mc-module summary:focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: -4px;
    }

    .mc-module-header {
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }

    .mc-module-icon {
        width: 65px;
        height: 65px;
        min-width: 65px;

        display: grid;
        place-items: center;

        background: var(--icon-bg);
        color: var(--accent-dark);
        border-radius: 19px;
    }

    .mc-module-icon svg {
        width: 35px !important;
        height: 35px !important;
    }

    .mc-module-name {
        font-size: clamp(18px, 1.3vw, 22px);
        font-weight: 850;
        color: #173750;
        line-height: 1.25;
        margin: 3px 0 8px;
    }

    .mc-module-description {
        color: #677b8e;
        font-size: 13px;
        line-height: 1.6;
        margin-bottom: 0;
    }

    .mc-open-button {
        display: flex;
        align-items: center;
        justify-content: center;

        min-height: 43px;
        margin-top: 20px;
        padding: 10px 15px;

        border-radius: 12px;

        background: linear-gradient(
            120deg,
            var(--accent),
            var(--accent-dark)
        );

        color: white;
        font-size: 14px;
        font-weight: 800;
        box-shadow: 0 5px 14px rgba(20,75,100,.13);
    }

    .mc-close-label {
        display: none;
    }

    .mc-module[open] .mc-open-label {
        display: none;
    }

    .mc-module[open] .mc-close-label {
        display: inline;
    }

    /* Hidden until the main card is clicked */

    .mc-module-links {
        display: grid;
        gap: 8px;

        padding: 15px 18px 18px;

        border-top: 1px solid #e2ebf3;
        background: rgba(255,255,255,.96);
    }

    .mc-module-links a {
        display: block;
        padding: 11px 14px;

        border-radius: 10px;
        background: #f3f7fb;
        border: 1px solid #e3ebf3;

        color: #294962;
        font-size: 14px;
        font-weight: 700;

        transition: background .2s, color .2s;
    }

    .mc-module-links a:hover {
        background: var(--tint);
        color: var(--accent-dark);
        border-color: var(--accent);
    }

    .mc-empty-links {
        color: #708398;
        font-size: 13px;
        margin: 3px 0;
    }

    /* Individual section colors */

    .mc-patient {
        --accent: #10b7a9;
        --accent-dark: #07827d;
        --tint: #def9f4;
        --icon-bg: #c9f1ea;
    }

    .mc-doctor {
        --accent: #2398ed;
        --accent-dark: #146bc2;
        --tint: #e4f2ff;
        --icon-bg: #d8ebff;
    }

    .mc-clinical {
        --accent: #a36ae4;
        --accent-dark: #7947bd;
        --tint: #f1e5ff;
        --icon-bg: #e9ddff;
    }

    .mc-billing {
        --accent: #faa238;
        --accent-dark: #d67a13;
        --tint: #fff1dd;
        --icon-bg: #ffe5c1;
    }

    .mc-staff {
        --accent: #2cb76c;
        --accent-dark: #128748;
        --tint: #e0f9e8;
        --icon-bg: #cdf4da;
    }

    .mc-reports {
        --accent: #477db8;
        --accent-dark: #275185;
        --tint: #e6f0fb;
        --icon-bg: #dce9f8;
    }

    /* ========================================
       DASHBOARD FOOTER
       ======================================== */

    .mc-dashboard-footer {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;

        padding: 17px 30px;

        background: #f9fbff;
        border-top: 1px solid #dce7f1;
        color: #697e91;

        font-size: 13px;
    }

    .mc-dashboard-footer a {
        color: #09998f;
        font-weight: 700;
    }

    /* ========================================
       RESPONSIVE DESIGN
       ======================================== */

    @@media (max-width: 1250px) {
        .mc-module-grid {
            grid-template-columns: repeat(2, minmax(0,1fr));
        }
    }

    @@media (max-width: 850px) {
        #mc-dashboard-ui {
            grid-template-columns: 190px minmax(0,1fr);
        }

        .mc-sidebar {
            padding: 20px 11px;
        }

        .mc-sidebar-brand img {
            width: 145px;
        }

        .mc-topbar {
            padding: 12px 18px;
        }

        .mc-dashboard-content {
            padding: 20px;
        }
    }

    @@media (max-width: 700px) {
        #mc-dashboard-ui {
            display: block;
        }

        .mc-sidebar {
            position: static;
            height: auto;
            padding: 13px;

            flex-direction: row;
            align-items: center;
            gap: 10px;
        }

        .mc-sidebar-brand {
            padding: 8px;
        }

        .mc-sidebar-brand img {
            width: 110px;
        }

        .mc-sidebar-heading,
        .mc-sidebar-bottom {
            display: none;
        }

        .mc-sidebar-nav {
            flex-direction: row;
            overflow-x: auto;
        }

        .mc-sidebar-link {
            white-space: nowrap;
            padding: 9px;
            font-size: 12px;
        }

        .mc-sidebar-link svg {
            display: none;
        }

        .mc-user-email {
            display: none;
        }

        .mc-topbar {
            padding: 12px;
        }

        .mc-hero-copy {
            max-width: 100%;
            padding: 25px;
        }

        .mc-hero-image {
            width: 100%;
            opacity: .2;
        }

        .mc-module-grid {
            grid-template-columns: 1fr;
        }

        .mc-dashboard-content {
            padding: 15px;
        }

        .mc-module summary {
            min-height: 165px;
        }

        .mc-section-count {
            display: none;
        }
    }

    /* Compact cards on laptop screens */

    @@media (min-width: 1251px) and (max-height: 820px) {
        .mc-topbar {
            min-height: 60px;
        }

        .mc-dashboard-content {
            padding-top: 15px;
        }

        .mc-hero {
            min-height: 160px;
        }

        .mc-hero-copy {
            padding-top: 18px;
            padding-bottom: 18px;
        }

        .mc-section-title {
            margin: 18px 0 13px;
        }

        .mc-module-grid {
            gap: 14px;
        }

        .mc-module summary {
            min-height: 160px;
            padding: 17px;
        }

        .mc-module-icon {
            width: 54px;
            height: 54px;
            min-width: 54px;
        }

        .mc-module-icon svg {
            width: 29px !important;
            height: 29px !important;
        }

        .mc-open-button {
            min-height: 36px;
            margin-top: 12px;
            padding: 8px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        #mc-dashboard-ui * {
            transition: none !important;
        }
    }
</style>

<!-- Reusable dashboard icons -->
<svg class="mc-icon-sprite"
     xmlns="http://www.w3.org/2000/svg"
     aria-hidden="true">

    <symbol id="mc-home" viewBox="0 0 24 24">
        <path d="m3 10 9-7 9 7v10H4V10z"/>
        <path d="M9 21v-8h6v8"/>
    </symbol>

    <symbol id="mc-grid" viewBox="0 0 24 24">
        <rect x="3" y="3" width="7" height="7" rx="1"/>
        <rect x="14" y="3" width="7" height="7" rx="1"/>
        <rect x="3" y="14" width="7" height="7" rx="1"/>
        <rect x="14" y="14" width="7" height="7" rx="1"/>
    </symbol>

    <symbol id="mc-users" viewBox="0 0 24 24">
        <circle cx="9" cy="8" r="3"/>
        <path d="M3 20v-2a6 6 0 0 1 12 0v2"/>
        <path d="M17 5a3 3 0 0 1 0 6"/>
        <path d="M18 15a5 5 0 0 1 3 5"/>
    </symbol>

    <symbol id="mc-doctor" viewBox="0 0 24 24">
        <circle cx="12" cy="6" r="3"/>
        <path d="M6 21v-5a6 6 0 0 1 12 0v5"/>
        <path d="M8 12v3a4 4 0 0 0 8 0v-3"/>
    </symbol>

    <symbol id="mc-clinical" viewBox="0 0 24 24">
        <rect x="5" y="4" width="14" height="17" rx="2"/>
        <path d="M9 4V2h6v2"/>
        <path d="M12 10v7M8.5 13.5h7"/>
    </symbol>

    <symbol id="mc-billing" viewBox="0 0 24 24">
        <path d="M5 3h14v18l-3-2-4 2-4-2-3 2z"/>
        <path d="M8 8h8M8 12h8M8 16h5"/>
    </symbol>

    <symbol id="mc-shield" viewBox="0 0 24 24">
        <path d="m12 2 9 4v6c0 5-3.5 8-9 10-5.5-2-9-5-9-10V6z"/>
        <path d="m9 12 2 2 4-4"/>
    </symbol>

    <symbol id="mc-lock" viewBox="0 0 24 24">
        <rect x="4" y="10" width="16" height="11" rx="2"/>
        <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
    </symbol>
</svg>

<div id="mc-dashboard-ui">

    <!-- LEFT SIDEBAR -->
    <aside class="mc-sidebar">

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="mc-sidebar-brand">

            <img src="~/images/medicare-logo.png"
                 asp-append-version="true"
                 alt="MediCare" />

        </a>

        <div class="mc-sidebar-heading">
            WORKSPACE
        </div>

        <nav class="mc-sidebar-nav">

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="mc-sidebar-link active"
               aria-current="page">
                <svg><use href="#mc-home"/></svg>
                Dashboard
            </a>

            <a href="#mc-modules"
               class="mc-sidebar-link">
                <svg><use href="#mc-grid"/></svg>
                Hospital Modules
            </a>

            @if (isAdmin)
            {
                <a asp-controller="Reports"
                   asp-action="Index"
                   class="mc-sidebar-link">
                    <svg><use href="#mc-shield"/></svg>
                    Reports
                </a>
            }

            <a asp-controller="Account"
               asp-action="ChangePassword"
               class="mc-sidebar-link">
                <svg><use href="#mc-lock"/></svg>
                Change Password
            </a>

        </nav>

        <div class="mc-sidebar-bottom">
            <strong>Better Care.</strong>
            A Healthier Tomorrow.
        </div>

    </aside>

    <!-- MAIN WORKSPACE -->
    <div class="mc-workspace">

        <!-- TOP BAR -->
        <div class="mc-topbar">

            <div class="mc-topbar-title">
                <span class="mc-status-dot"></span>
                Hospital Dashboard
            </div>

            <div class="mc-topbar-actions">

                <span class="mc-user-email">
                    @User.Identity?.Name
                </span>

                <a asp-controller="Account"
                   asp-action="ChangePassword"
                   class="mc-action-btn mc-password-btn">
                    Change Password
                </a>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="m-0">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="mc-action-btn mc-logout-btn">
                        Logout
                    </button>
                </form>

            </div>

        </div>

        <div class="mc-dashboard-content">

            <!-- WELCOME BANNER -->
            <section class="mc-hero">

                <div class="mc-hero-image"
                     aria-hidden="true"></div>

                <div class="mc-hero-copy">

                    <p class="mc-hero-kicker">
                        MEDICARE HOSPITAL MANAGEMENT
                    </p>

                    <h1>Welcome to MediCare</h1>

                    <p class="mc-hero-description">
                        One connected workspace for
                        managing hospital operations.
                    </p>

                    <div class="mc-hero-tagline">
                        Manage efficiently. Care better.
                    </div>

                </div>

            </section>

            <!-- SECTION HEADING -->
            <div class="mc-section-title" id="mc-modules">

                <div>
                    <h2>Hospital Management</h2>
                    <p>
                        Choose a section to view its functions.
                    </p>
                </div>

                <span class="mc-section-count">
                    6 MAIN SECTIONS
                </span>

            </div>

            <!-- SIX EXPANDABLE CARDS -->
            <div class="mc-module-grid">

                <!-- 1. PATIENT MANAGEMENT -->
                <details class="mc-module mc-patient"
                         name="medicare-section">

                    <summary>

                        <div class="mc-module-header">

                            <span class="mc-module-icon">
                                <svg><use href="#mc-users"/></svg>
                            </span>

                            <div>
                                <h3 class="mc-module-name">
                                    Patient Management
                                </h3>

                                <p class="mc-module-description">
                                    Patient registration and appointments
                                </p>
                            </div>

                        </div>

                        <span class="mc-open-button">
                            <span class="mc-open-label">
                                Open section
                            </span>
                            <span class="mc-close-label">
                                Close section
                            </span>
                        </span>

                    </summary>

                    <nav class="mc-module-links"
                         aria-label="Patient Management">

                        @if (isAdmin || isReceptionist)
                        {
                            <a asp-controller="Patients"
                               asp-action="Create">
                                Register Patient
