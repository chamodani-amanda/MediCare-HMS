@model MediCare.Web.Models.Medicine
@{ ViewData["Title"] = "Medicine Details"; }
<div class="py-4"><h1>Medicine Details</h1><p>Identity fields cannot be changed after registration. Register a distinct item for a different strength, formulation or dispensing unit.</p><form method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="Version" type="hidden" />
<div class="row g-3"><div class="col-md-4"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" /></div><div class="col-md-4"><label asp-for="Name" class="form-label">Brand / medicine name</label><input asp-for="Name" class="form-control" /></div><div class="col-md-4"><label asp-for="GenericName" class="form-label"></label><input asp-for="GenericName" class="form-control" /></div><div class="col-md-4"><label asp-for="Strength" class="form-label"></label><input asp-for="Strength" class="form-control" /></div><div class="col-md-4"><label asp-for="Formulation" class="form-label"></label><input asp-for="Formulation" class="form-control" /></div><div class="col-md-4"><label asp-for="DispensingUnit" class="form-label"></label><input asp-for="DispensingUnit" class="form-control" /></div><div class="col-md-4"><label asp-for="LowStockThreshold" class="form-label"></label><input asp-for="LowStockThreshold" type="number" min="0" step="0.001" class="form-control" /></div></div><div class="form-check my-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Active</label></div><button class="btn btn-primary">Save</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form></div>
