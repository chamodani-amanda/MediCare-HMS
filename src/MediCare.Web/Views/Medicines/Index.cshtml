@model MediCare.Web.ViewModels.PharmacyPage<MediCare.Web.Models.Medicine>
@{ ViewData["Title"] = "Medicine Catalogue"; }
<div class="py-4"><h1>Medicine Catalogue</h1><p>Exact medicine identities are preserved for prescriptions and dispensing history.</p>
<div class="d-flex gap-2 mb-3"><a asp-action="Create" class="btn btn-primary">Register medicine</a>@if(User.IsInRole("Pharmacist")){<a asp-controller="Pharmacy" asp-action="Index" class="btn btn-outline-primary">Pharmacy</a>}</div>
<form method="get" class="row g-2 mb-3"><div class="col-md-5"><input name="search" value="@Model.Search" maxlength="100" placeholder="Code, name or generic name" aria-label="Search" class="form-control" /></div><div class="col-md-3"><select name="filter" class="form-select" aria-label="Status"><option value="">All statuses</option><option value="active" selected="@(Model.Filter=="active")">Active</option><option value="inactive" selected="@(Model.Filter=="inactive")">Inactive</option></select></div><div class="col-md-2"><select name="sort" class="form-select" aria-label="Sort"><option value="code">Code</option><option value="name" selected="@(Model.Sort=="name")">Name</option></select></div><div class="col-md-2"><button class="btn btn-secondary">Search</button></div></form>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Medicine</th><th>Status</th><th>Low threshold</th><th>Actions</th></tr></thead><tbody>@foreach(var m in Model.Rows){<tr><td>@m.Label</td><td>@(m.IsActive?"Active":"Inactive")</td><td>@m.LowStockThreshold</td><td><a asp-action="Edit" asp-route-id="@m.Id">Edit</a>@if(User.IsInRole("Pharmacist") && m.IsActive){<a class="ms-2" asp-controller="Pharmacy" asp-action="Receive" asp-route-medicineId="@m.Id">Receive stock</a>}</td></tr>}</tbody></table></div>
<p>@Model.Total medicines · Page @Model.Page of @Model.Pages</p>@if(Model.Page>1){<a asp-route-page="@(Model.Page-1)" asp-route-search="@Model.Search" asp-route-filter="@Model.Filter" asp-route-sort="@Model.Sort" class="btn btn-outline-secondary">Previous</a>} @if(Model.Page<Model.Pages){<a asp-route-page="@(Model.Page+1)" asp-route-search="@Model.Search" asp-route-filter="@Model.Filter" asp-route-sort="@Model.Sort" class="btn btn-outline-secondary">Next</a>}</div>
