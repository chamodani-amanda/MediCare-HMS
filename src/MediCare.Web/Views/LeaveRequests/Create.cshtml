@using Microsoft.AspNetCore.Mvc.Rendering
@model MediCare.Web.ViewModels.LeaveRequestCreateViewModel

@{
    ViewData["Title"] = "New Leave Request";

    var employeeOptions =
        ViewBag.EmployeeOptions as List<SelectListItem>
        ?? new List<SelectListItem>();
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="fw-bold">New Leave Request</h1>

        <p class="text-muted">
            Submit a leave request for a registered employee.
        </p>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <form asp-controller="LeaveRequests"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="EmployeeId"
                               class="form-label"></label>

                        <select asp-for="EmployeeId"
                                asp-items="employeeOptions"
                                class="form-select">

                            <option value="">
                                Select Employee
                            </option>

                        </select>

                        <span asp-validation-for="EmployeeId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LeaveType"
                               class="form-label"></label>

                        <select asp-for="LeaveType"
                                class="form-select">

                            <option value="">
                                Select Leave Type
                            </option>

                            <option value="Annual Leave">
                                Annual Leave
                            </option>

                            <option value="Sick Leave">
                                Sick Leave
                            </option>

                            <option value="Casual Leave">
                                Casual Leave
                            </option>

                        </select>

                        <span asp-validation-for="LeaveType"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="StartDate"
                               class="form-label"></label>

                        <input asp-for="StartDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="StartDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EndDate"
                               class="form-label"></label>

                        <input asp-for="EndDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="EndDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Reason"
                               class="form-label"></label>

                        <textarea asp-for="Reason"
                                  class="form-control"
                                  rows="4"
                                  maxlength="500"
                                  placeholder="Enter leave reason"></textarea>

                        <span asp-validation-for="Reason"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a asp-controller="LeaveRequests"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Submit Leave Request
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}