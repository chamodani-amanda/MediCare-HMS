@model MediCare.Web.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center align-items-center py-5">
    <div class="col-lg-10">

        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="row g-0">

                <div class="col-lg-6 medicare-login-brand p-5">
                    <div class="mb-5">
                        <h2 class="fw-bold">MediCare</h2>
                        <p class="opacity-75">
                            Smart Healthcare. Seamless Management.
                        </p>
                    </div>

                    <h1 class="fw-bold display-6">
                        Better care begins with better management.
                    </h1>

                    <p class="mt-4 opacity-75">
                        One connected workspace for hospital teams,
                        patient services and healthcare operations.
                    </p>

                    <div class="mt-5">
                        <span class="badge rounded-pill text-bg-light">
                            Secure Staff Portal
                        </span>
                    </div>
                </div>

                <div class="col-lg-6 bg-white p-5">

                    <h3 class="fw-bold mb-2">Welcome Back</h3>

                    <p class="text-muted mb-4">
                        Sign in to your MediCare account.
                    </p>

                    <form asp-controller="Account"
                          asp-action="Login"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="ReturnUrl" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email"
                                   class="form-label fw-semibold">
                                Email Address
                            </label>

                            <input asp-for="Email"
                                   class="form-control form-control-lg"
                                   placeholder="Enter your email"
                                   autocomplete="username" />

                            <span asp-validation-for="Email"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password"
                                   class="form-label fw-semibold">
                                Password
                            </label>

                            <input asp-for="Password"
                                   class="form-control form-control-lg"
                                   placeholder="Enter your password"
                                   autocomplete="current-password" />

                            <span asp-validation-for="Password"
                                  class="text-danger"></span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary btn-lg w-100">
                            Sign In
                        </button>

                        <p class="text-center text-muted small mt-4">
                            Authorized hospital personnel only.
                        </p>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}