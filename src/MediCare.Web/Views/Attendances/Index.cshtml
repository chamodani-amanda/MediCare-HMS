@using Microsoft.AspNetCore.Mvc.Rendering
@model IReadOnlyList<MediCare.Web.Models.Attendance>

@{
    ViewData["Title"] = "Staff Attendance";

    var employeeOptions =
        ViewBag.EmployeeOptions as List<SelectListItem>
        ?? new List<SelectListItem>();

    var sriLanka =
        TimeZoneInfo.FindSystemTimeZoneById("Asia/Colombo");
}

<div class="container py-4">

    <h1 class="fw-bold">Staff Attendance</h1>

    <p class="text-muted">
        Manage employee check-in and check-out records.
        Times are displayed in Sri Lanka time.
    </p>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success">
            @success
        </div>
    }

    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger">
            @error
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">
                Record Employee Check-In
            </h5>

            <form asp-controller="Attendances"
                  asp-action="CheckIn"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">
                            Select Employee
                        </label>

                        <select name="employeeId"
                                asp-items="employeeOptions"
                                class="form-select"
                                required>

                            <option value="">
                                Select an employee
                            </option>

                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            Notes (Optional)
                        </label>

                        <input name="notes"
                               maxlength="500"
                               class="form-control"
                               placeholder="Attendance remarks" />
                    </div>

                </div>

                <button type="submit"
                        class="btn btn-primary mt-3">
                    Check In
                </button>

            </form>

        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-4">
                Attendance History
            </h5>

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Employee</th>
                            <th>Date</th>
                            <th>Check In</th>
                            <th>Check Out</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var record in Model)
                        {
                            <tr>

                                <td>
                                    @record.Employee.FirstName
                                    @record.Employee.LastName
                                </td>

                                <td>
                                    @record.WorkDate.ToString("yyyy-MM-dd")
                                </td>

                                <td>
                                    @TimeZoneInfo.ConvertTimeFromUtc(
                                        record.CheckInAtUtc, sriLanka)
                                        .ToString("HH:mm")
                                </td>

                                <td>
                                    @if (record.CheckOutAtUtc.HasValue)
                                    {
                                        @TimeZoneInfo.ConvertTimeFromUtc(
                                            record.CheckOutAtUtc.Value,
                                            sriLanka).ToString("HH:mm")
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>

                                <td>
                                    @if (record.CheckOutAtUtc.HasValue)
                                    {
                                        <span class="badge bg-success">
                                            Completed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Checked In
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (!record.CheckOutAtUtc.HasValue)
                                    {
                                        <form asp-controller="Attendances"
                                              asp-action="CheckOut"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@record.Id" />

                                            <input type="hidden"
                                                   name="version"
                                                   value="@record.Version" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-primary">
                                                Check Out
                                            </button>

                                        </form>
                                    }
                                </td>

                            </tr>
                        }

                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-muted py-4">
                                    No attendance records found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>