@model MediCare.Web.ViewModels.ClinicalStayForm
@{ViewData["Title"]=Model.Inpatient?"Admission Clinical Draft":"Outpatient Follow-up";}
<div class="py-4"><h1>@ViewData["Title"]</h1><p class="text-muted">Restricted to the assigned treating doctor. Existing EMR finalization and care permissions are unchanged.</p><form asp-action="Clinical" asp-route-id="@Model.Id" method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="ParentVersion" type="hidden" /><input asp-for="Version" type="hidden" />
@if(Model.Inpatient){<div class="mb-3"><label asp-for="AdmissionReason" class="form-label">Clinical admission reason</label><textarea asp-for="AdmissionReason" maxlength="4000" required class="form-control" rows="4"></textarea></div><div class="mb-3"><label asp-for="DischargeSummary" class="form-label">Discharge summary draft (required before clearance)</label><textarea asp-for="DischargeSummary" maxlength="8000" class="form-control" rows="6"></textarea></div>}else{<div class="mb-3"><label asp-for="FollowUpInformation" class="form-label">Follow-up information (optional)</label><textarea asp-for="FollowUpInformation" maxlength="4000" class="form-control" rows="4"></textarea></div><div class="mb-3"><label asp-for="FollowUpOn" class="form-label">Follow-up date (optional; does not book an appointment)</label><input asp-for="FollowUpOn" type="date" class="form-control" /></div>}
<div class="mb-3"><label asp-for="MedicalRecordId" class="form-label">Existing authorized finalized EMR reference (optional)</label><select asp-for="MedicalRecordId" class="form-select"><option value="">No EMR reference</option>@foreach(var r in Model.Records.GroupBy(r=>r.Id).Select(g=>g.First())){<option value="@r.Id">@MediCare.Web.Services.HospitalTime.Local(r.CreatedAtUtc).ToString("yyyy-MM-dd HH:mm") — Dr. @r.DoctorName — finalized revision @r.Number</option>}</select><div class="form-text">Only encounters available under your existing appointment-based care permissions appear. Walk-in registration grants no new EMR access.</div></div>
<button class="btn btn-primary">Save clinical draft</button> <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Back</a></form></div>
