@model MediCare.Web.ViewModels.CarePage<MediCare.Web.ViewModels.CareSummary>
@{var inpatient=ViewContext.RouteData.Values["controller"]?.ToString()=="Admissions";ViewData["Title"]=inpatient?"Inpatient Admissions":"Outpatient Visits";var states=inpatient?Enum.GetNames<MediCare.Web.Models.AdmissionStatus>():Enum.GetNames<MediCare.Web.Models.OutpatientVisitStatus>();}
<div class="py-4"><h1>@ViewData["Title"]</h1><p class="text-muted">Administrative history and your authorized treating-doctor scope. Clinical records retain their existing permissions.</p>
@if(User.IsInRole("Receptionist")){<a asp-action="Create" class="btn btn-primary mb-3">@(inpatient?"Admit patient":"Register visit")</a>}
<form method="get" class="row g-2 mb-3">
<div class="col-md-4"><input name="search" value="@Model.Search" maxlength="100" class="form-control" placeholder="Patient name or number" aria-label="Search" /></div>
<div class="col-md-3"><select name="state" class="form-select" aria-label="Status"><option value="">@(inpatient?"Active admissions":"All statuses")</option>@foreach(var state in states){<option value="@state" selected="@(Model.State==state)">@state</option>}</select></div>
<div class="col-md-3"><select name="doctorId" class="form-select" aria-label="Treating doctor"><option value="">All authorized doctors</option>@foreach(var d in Model.Doctors){<option value="@d.Id" selected="@(Model.DoctorId==d.Id)">@d.FirstName @d.LastName</option>}</select></div>
@if(!inpatient){<div class="col-md-3"><input type="date" name="date" value="@Model.Date?.ToString("yyyy-MM-dd")" aria-label="Registration date" class="form-control" /></div>}<div class="col-md-2"><button class="btn btn-secondary">Filter</button></div></form>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Patient</th><th>Doctor / department</th><th>Registered (Colombo)</th><th>Status</th><th>Bed</th><th></th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr><td>@row.PatientLabel</td><td>@row.DoctorLabel<br />@row.Department</td><td>@MediCare.Web.Services.HospitalTime.Local(row.StartedAtUtc).ToString("yyyy-MM-dd HH:mm")</td><td>@row.State</td><td>@row.BedLabel</td><td><a asp-action="Details" asp-route-id="@row.Id">Details</a></td></tr>}</tbody></table></div><p>@Model.Total records · Page @Model.Page of @Model.Pages</p>
@if(Model.Page>1){<a asp-route-page="@(Model.Page-1)" asp-route-search="@Model.Search" asp-route-state="@Model.State" asp-route-doctorId="@Model.DoctorId" asp-route-date="@Model.Date?.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">Previous</a>} @if(Model.Page<Model.Pages){<a asp-route-page="@(Model.Page+1)" asp-route-search="@Model.Search" asp-route-state="@Model.State" asp-route-doctorId="@Model.DoctorId" asp-route-date="@Model.Date?.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">Next</a>}</div>
