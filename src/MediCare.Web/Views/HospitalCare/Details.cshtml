@model MediCare.Web.ViewModels.CareDetails
@using MediCare.Web.Services
@{ViewData["Title"]=Model.Inpatient?"Admission Details":"Outpatient Visit Details";var r=Model.Row;}
<div class="py-4"><h1>@ViewData["Title"]</h1><div class="card card-body mb-3"><h2 class="h4">@r.PatientLabel</h2><p>@r.DoctorLabel · @r.Department</p><p>Status: <strong>@r.State</strong> · @r.BedLabel</p><p>Registered: @HospitalTime.Local(r.StartedAtUtc).ToString("yyyy-MM-dd HH:mm:ss") Asia/Colombo</p>@if(r.ClosedAtUtc.HasValue){<p>Closed: @HospitalTime.Local(r.ClosedAtUtc.Value).ToString("yyyy-MM-dd HH:mm:ss") Asia/Colombo</p>}</div>
@if(Model.CanClinical){<section class="card card-body mb-3"><h2 class="h5">Treating-doctor information</h2>@if(Model.Inpatient&&Model.AdmissionClinical is {} n){<h3 class="h6">Admission reason</h3><p style="white-space:pre-wrap">@n.AdmissionReason</p><h3 class="h6">Discharge summary</h3><p style="white-space:pre-wrap">@n.DischargeSummary</p>}@if(!Model.Inpatient&&Model.OutpatientClinical is {} o){<p style="white-space:pre-wrap">@o.FollowUpInformation</p><p>Follow-up date: @o.FollowUpOn</p>}@if(Model.VisibleEmrRevisionId.HasValue){<a asp-controller="MedicalRecords" asp-action="Details" asp-route-id="@Model.VisibleEmrRevisionId">Authorized EMR record</a>}
@if((Model.Inpatient&&r.State=="Admitted")||(!Model.Inpatient&&r.State=="InConsultation")){<a asp-action="Clinical" asp-route-id="@r.Id" class="btn btn-outline-primary align-self-start">Edit clinical draft</a>}
@if(Model.Inpatient&&r.State=="Admitted"){<form asp-action="Clearance" asp-route-id="@r.Id" method="post" class="mt-3"><input name="version" value="@r.Version" type="hidden" /><button class="btn btn-success">Approve discharge readiness</button><p class="form-text">Save the clinical reason and discharge summary first. Clearance freezes those notes; the bed stays occupied until Receptionist checkout. Clearance cannot be withdrawn in this workflow.</p></form>}
@if(!Model.Inpatient&&(r.State=="Registered"||r.State=="InConsultation")){<form asp-action="Progress" asp-route-id="@r.Id" method="post" class="mt-3"><input name="version" value="@r.Version" type="hidden" /><input name="command" value="@(r.State=="Registered"?"Start":"Complete")" type="hidden" /><button class="btn btn-primary">@(r.State=="Registered"?"Start consultation":"Complete visit")</button></form>}
</section>}
@if(User.IsInRole("Receptionist")){
if(Model.Inpatient&&r.State=="Admitted"){<form asp-action="Transfer" asp-route-id="@r.Id" method="post" class="card card-body mb-3"><h2 class="h5">Bed transfer</h2><input name="version" value="@r.Version" type="hidden" /><input name="token" value="@Guid.NewGuid()" type="hidden" /><label for="bedId" class="form-label">Available bed in treating department</label><select id="bedId" name="bedId" required class="form-select mb-2"><option value="">Choose a bed</option>@foreach(var b in Model.AvailableBeds){<option value="@b.Id">@b.Ward.Code / @b.Number</option>}</select><label for="reason" class="form-label">Administrative transfer reason (no clinical notes)</label><textarea id="reason" name="reason" maxlength="1000" required class="form-control mb-2"></textarea><button class="btn btn-outline-primary">Transfer bed</button></form>}
if(Model.Inpatient&&r.State=="DischargeReady"){<form asp-action="Discharge" asp-route-id="@r.Id" method="post" class="mb-3"><input name="version" value="@r.Version" type="hidden" /><input name="token" value="@Guid.NewGuid()" type="hidden" /><p>The treating doctor has cleared discharge. Checkout will release the bed and preserve history.</p><button class="btn btn-success">Complete discharge checkout</button></form>}
if(!Model.Inpatient&&r.State=="Registered"){<form asp-action="Cancel" asp-route-id="@r.Id" method="post" class="card card-body mb-3"><input name="version" value="@r.Version" type="hidden" /><label for="cancelReason" class="form-label">Administrative cancellation reason</label><textarea id="cancelReason" name="reason" maxlength="500" required class="form-control mb-2"></textarea><button class="btn btn-outline-danger">Cancel registered visit</button></form>}}
@if(Model.Inpatient){<h2 class="h4">Bed assignment and transfer history</h2><div class="table-responsive"><table class="table"><thead><tr><th>Time (Colombo)</th><th>From</th><th>To</th><th>Reason</th><th>Staff reference</th></tr></thead><tbody>@foreach(var t in Model.Transfers){<tr><td>@HospitalTime.Local(t.OccurredAtUtc).ToString("yyyy-MM-dd HH:mm:ss")</td><td>@t.FromBed?.Ward.Code / @t.FromBed?.Number</td><td>@t.ToBed?.Ward.Code / @t.ToBed?.Number</td><td>@t.Reason</td><td>@t.ActorUserId</td></tr>}</tbody></table></div>}
<h2 class="h4">Authorized patient history</h2><ul>@foreach(var h in Model.History){<li><a asp-action="Details" asp-route-id="@h.Id">@HospitalTime.Local(h.StartedAtUtc).ToString("yyyy-MM-dd HH:mm") · @h.State · @h.DoctorLabel</a></li>}</ul><a asp-action="Index" class="btn btn-outline-secondary">Back to list</a></div>
