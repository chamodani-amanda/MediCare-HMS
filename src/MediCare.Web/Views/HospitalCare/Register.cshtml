@model MediCare.Web.ViewModels.CareRegistrationForm
@{ViewData["Title"]=Model.Inpatient?"Admit Patient":"Register Outpatient Visit";}
<div class="py-4"><h1>@ViewData["Title"]</h1><p class="text-muted">Registration time is recorded now in UTC and displayed in Asia/Colombo. No clinical notes are collected by reception.</p>
<form method="get" class="d-flex gap-2 mb-3"><input name="search" maxlength="100" class="form-control" aria-label="Patient lookup" placeholder="Search active patients (up to 50 matches)" /><button class="btn btn-outline-primary">Find patient</button></form>
<form asp-action="Create" method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="Token" type="hidden" />
<div class="mb-3"><label asp-for="PatientId" class="form-label">Patient</label><select asp-for="PatientId" class="form-select" required><option value="">Choose an existing active patient</option>@foreach(var p in Model.Patients){<option value="@p.Id">@p.PatientNumber — @p.FirstName @p.LastName</option>}</select></div>
<div class="mb-3"><label asp-for="DoctorId" class="form-label">Treating doctor</label><select asp-for="DoctorId" class="form-select" required><option value="">Choose an active linked doctor</option>@foreach(var d in Model.Doctors){<option value="@d.Id">@d.FirstName @d.LastName</option>}</select></div>
@if(Model.Inpatient){<div class="mb-3"><label asp-for="BedId" class="form-label">Available bed (must match the doctor's department)</label><select asp-for="BedId" class="form-select" required><option value="">Choose an operational available bed</option>@foreach(var b in Model.Beds){<option value="@b.Id">@b.Ward.Code / @b.Number</option>}</select></div>}
else{<div class="mb-3"><label asp-for="AppointmentId" class="form-label">Existing appointment (optional for walk-ins)</label><select asp-for="AppointmentId" class="form-select"><option value="">Walk-in — no linked appointment</option>@foreach(var a in Model.Appointments){<option value="@a.Id">@a.Patient.PatientNumber / @a.Patient.FirstName @a.Patient.LastName — @a.Doctor.FirstName @a.Doctor.LastName — @MediCare.Web.Services.HospitalTime.Local(a.StartAtUtc).ToString("yyyy-MM-dd HH:mm")</option>}</select><div class="form-text">Choose matching patient and doctor above. Up to 100 eligible appointments are shown; use patient search to narrow the list. One visit per appointment.</div></div>}
<button class="btn btn-primary">@(Model.Inpatient?"Admit and assign bed":"Register visit")</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form></div>
