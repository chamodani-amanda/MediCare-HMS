@model MediCare.Web.ViewModels.AppointmentListViewModel
@using MediCare.Web.Models
@{ ViewData["Title"] = "Appointments"; bool manager = User.IsInRole("Administrator") || User.IsInRole("Receptionist"); }
<div class="py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div><h1 class="fw-bold">Appointments</h1><p class="text-muted">@(manager ? "Manage patient bookings and follow their status." : "View appointments assigned to your linked doctor profile.")</p></div>
        <div class="d-flex flex-wrap gap-2"><a asp-action="Calendar" asp-route-doctorId="@Model.DoctorId" class="btn btn-outline-primary">Weekly Schedule</a>
        @if (manager) { <a asp-action="Availability" class="btn btn-outline-secondary">Find Availability</a><a asp-action="Create" class="btn btn-primary">Book Appointment</a> }</div>
    </div>
    <div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4">
        <form asp-action="Index" method="get" class="row g-3 mb-4 align-items-end">
            <div class="col-md-4"><label for="search" class="form-label">Patient name/number or doctor name</label><input id="search" name="search" value="@Model.Search" maxlength="100" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="DoctorId" class="form-label">Doctor</label><select asp-for="DoctorId" asp-items="Model.Doctors" class="form-select"><option value="">All authorized doctors</option></select></div>
            <div class="col-md-2"><label asp-for="Date" class="form-label"></label><input asp-for="Date" type="date" class="form-control" /></div>
            <div class="col-md-2"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<AppointmentStatus>()" class="form-select"><option value="">All statuses</option></select></div>
            <div class="col-md-1"><button class="btn btn-primary" type="submit">Filter</button></div>
        </form>
        <p class="text-muted">@Model.TotalAppointments appointment(s) · Times in Asia/Colombo <a asp-action="Index" class="ms-2">Clear filters</a></p>
        <partial name="_Rows" model="Model.Appointments" />
        <nav aria-label="Appointment pages" class="d-flex gap-3 align-items-center">
            @if (Model.Page > 1) { <a asp-action="Index" asp-route-page="@(Model.Page-1)" asp-route-search="@Model.Search" asp-route-doctorId="@Model.DoctorId" asp-route-date="@Model.Date?.ToString("yyyy-MM-dd")" asp-route-status="@Model.Status">Previous</a> }
            <span>Page @Model.Page of @Model.TotalPages</span>
            @if (Model.Page < Model.TotalPages) { <a asp-action="Index" asp-route-page="@(Model.Page+1)" asp-route-search="@Model.Search" asp-route-doctorId="@Model.DoctorId" asp-route-date="@Model.Date?.ToString("yyyy-MM-dd")" asp-route-status="@Model.Status">Next</a> }
        </nav>
    </div></div>
</div>
