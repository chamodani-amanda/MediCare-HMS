@model MediCare.Web.ViewModels.PatientCreateViewModel

@{
    ViewData["Title"] = "Register Patient";
}

<div class="py-4">

    <div class="mb-4">
        <h1 class="fw-bold">Register New Patient</h1>
        <p class="text-muted">
            Enter patient information to begin registration.
        </p>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-4">Personal Information</h5>

            @if (ViewBag.ValidationPassed == true)
            {
                <div class="alert alert-info">
                    Validation successful. This is a demonstration
                    form. No patient information has been saved.
                </div>
            }
             
            @if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success">
        @message
    </div>
}

            <form asp-controller="Patients"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="FirstName"
                               class="form-label">First Name *</label>
                        <input asp-for="FirstName"
                               class="form-control" />
                        <span asp-validation-for="FirstName"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LastName"
                               class="form-label">Last Name *</label>
                        <input asp-for="LastName"
                               class="form-control" />
                        <span asp-validation-for="LastName"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DateOfBirth"
                               class="form-label">Date of Birth *</label>
                        <input asp-for="DateOfBirth"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="DateOfBirth"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Gender"
                               class="form-label">Gender</label>
                        <select asp-for="Gender" class="form-select">
                            <option value="">Select</option>
                            <option value="Female">Female</option>
                            <option value="Male">Male</option>
                            <option value="Other">Other</option>
                            <option value="Prefer not to say">
                                Prefer not to say
                            </option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PhoneNumber"
                               class="form-label">Phone Number</label>
                        <input asp-for="PhoneNumber"
                               class="form-control" />
                        <span asp-validation-for="PhoneNumber"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email"
                               class="form-label">Email</label>
                        <input asp-for="Email"
                               class="form-control" />
                        <span asp-validation-for="Email"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Address"
                               class="form-label">Address</label>
                        <textarea asp-for="Address"
                                  class="form-control"
                                  rows="3"></textarea>
                    </div>

                    <div class="col-12 mt-4">
                        <h5 class="fw-bold">
                            Emergency Contact
                        </h5>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EmergencyContactName"
                               class="form-label">Contact Name</label>
                        <input asp-for="EmergencyContactName"
                               class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EmergencyContactPhone"
                               class="form-label">Contact Phone</label>
                        <input asp-for="EmergencyContactPhone"
                               class="form-control" />
                        <span asp-validation-for="EmergencyContactPhone"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-primary px-4">
                        Validate Registration
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}