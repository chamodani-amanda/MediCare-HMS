@model MediCare.Web.ViewModels.PatientListViewModel

@{
    ViewData["Title"] = "Registered Patients";
}

<div class="py-4">
    @if (User.IsInRole("Administrator"))
    {
        <a asp-action="Archived" class="btn btn-outline-secondary mb-3">Archived Patients</a>
    }

    <div class="d-flex justify-content-between
                align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h1 class="fw-bold">Registered Patients</h1>

            <p class="text-muted mb-0">
                Search and view MediCare patient records.
            </p>
        </div>

        <a asp-controller="Patients"
           asp-action="Create"
           class="btn btn-primary">
            + Register Patient
        </a>

    </div>
    
    @if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="alert">
        @message
    </div>
}
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-4">
                Patient Directory
            </h5>

            @* Patient Search Form *@
            <form asp-controller="Patients"
                  asp-action="Index"
                  method="get"
                  class="row g-2 align-items-end mb-4">

                <div class="col-md-8">

                    <label for="patientSearch"
                           class="form-label fw-semibold">
                        Search Patients
                    </label>

                    <input type="search"
                           id="patientSearch"
                           name="search"
                           value="@Model.SearchTerm"
                           maxlength="100"
                           class="form-control"
                           placeholder="Name or patient number" />

                </div>

                <div class="col-md-2">
                    <button type="submit"
                            class="btn btn-primary w-100">
                        Search
                    </button>
                </div>

                <div class="col-md-2">
                    <a asp-controller="Patients"
                       asp-action="Index"
                       class="btn btn-outline-secondary w-100">
                        Clear
                    </a>
                </div>

            </form>

            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <div class="alert alert-info">
                    Search results for:
                    <strong>@Model.SearchTerm</strong>

                    <span class="ms-2">
                        (@Model.TotalPatients matching patients)
                    </span>
                </div>
            }

            <div class="d-flex justify-content-between
                        align-items-center mb-3">

                <h6 class="fw-bold mb-0">
                    Patient Records
                </h6>

                <span class="badge bg-primary">
                    Total: @Model.TotalPatients
                </span>

            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Patient Number</th>
                            <th>Full Name</th>
                            <th>Date of Birth</th>
                            <th>Registered (UTC)</th>
                            <th>Actions</th> 
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var patient in Model.Patients)
                        {
                            <tr>

                                <td class="fw-semibold">
                                    @patient.PatientNumber
                                </td>

                                <td>
                                    @patient.FullName
                                </td>

                                <td>
                                    @patient.DateOfBirth.ToString(
                                        "yyyy-MM-dd")
                                </td>

                                <td>
                                    @patient.CreatedAtUtc.ToString(
                                        "yyyy-MM-dd HH:mm")
                                </td>

                                <td>
    <div class="d-flex gap-2 flex-wrap">

        <a asp-controller="Patients"
           asp-action="Details"
           asp-route-id="@patient.Id"
           class="btn btn-sm btn-outline-secondary">
            View Profile
        </a>

        <a asp-controller="Patients"
           asp-action="Edit"
           asp-route-id="@patient.Id"
           class="btn btn-sm btn-outline-primary">
            Edit
        </a>

    </div>
</td>

                            </tr>
                        }

                        @if (Model.Patients.Count == 0)
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center text-muted py-4">

                                    @if (!string.IsNullOrWhiteSpace(
                                        Model.SearchTerm))
                                    {
                                        <span>
                                            No patients match your search.
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            No registered patients found.
                                        </span>
                                    }

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-between
                            align-items-center mt-3">

                    <span class="text-muted small">
                        Page @Model.Page of @Model.TotalPages
                    </span>

                    <div class="d-flex gap-2">

                        @if (Model.Page > 1)
                        {
                            <a asp-controller="Patients"
                               asp-action="Index"
                               asp-route-page="@(Model.Page - 1)"
                               asp-route-search="@Model.SearchTerm"
                               class="btn btn-outline-secondary btn-sm">
                                Previous
                            </a>
                        }

                        @if (Model.Page < Model.TotalPages)
                        {
                            <a asp-controller="Patients"
                               asp-action="Index"
                               asp-route-page="@(Model.Page + 1)"
                               asp-route-search="@Model.SearchTerm"
                               class="btn btn-outline-primary btn-sm">
                                Next
                            </a>
                        }

                    </div>

                </div>
            }

        </div>
    </div>

</div>
