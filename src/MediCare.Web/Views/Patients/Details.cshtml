@model MediCare.Web.ViewModels.PatientDetailsViewModel

@{
    ViewData["Title"] = "Patient Profile";
}

<div class="py-4">
    @if (TempData["DocumentError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }
    @if (User.IsInRole("Administrator"))
    {
        @if (Model.IsArchived)
        {
            <div class="alert alert-warning">This patient is archived.</div>
            <form asp-action="Reactivate" method="post">
                <input name="id" type="hidden" value="@Model.Id" />
                <input name="version" type="hidden" value="@Model.Version" />
                <button type="submit" class="btn btn-primary">Reactivate Patient</button>
            </form>
        }
        else
        {
            <a asp-action="Archive" asp-route-id="@Model.Id" class="btn btn-outline-danger">Archive Patient</a>
        }
    }
    <section class="card card-body my-4">
        <h2 class="h5">Patient Documents</h2>
        @if (!Model.IsArchived)
        {
            <form asp-action="UploadDocument" method="post" enctype="multipart/form-data">
                <input name="id" type="hidden" value="@Model.Id" />
                <label for="document">PDF, JPEG or PNG, maximum 5 MB</label>
                <input id="document" name="document" type="file" accept=".pdf,.jpg,.jpeg,.png" required class="form-control my-2" />
                <button class="btn btn-primary" type="submit">Upload Document</button>
            </form>
        }
        <ul class="mt-3">
        @foreach (var document in Model.Documents)
        {
            <li><a asp-action="DownloadDocument" asp-route-id="@Model.Id" asp-route-documentId="@document.Id">@document.OriginalFileName</a>
                (@document.Size bytes, @document.UploadedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC)</li>
        }
        </ul>
        @if (Model.Documents.Count == 0) { <p>No documents uploaded.</p> }
    </section>

    <div class="d-flex justify-content-between
                align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h1 class="fw-bold">Patient Profile</h1>

            <p class="text-muted mb-0">
                View registered patient information.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="Patients"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Back to Patients
            </a>

            @if (!Model.IsArchived)
            {
            <a asp-controller="Patients"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                Edit Patient
            </a>
            }

        </div>
    </div>

    @* Patient Summary *@

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">

            <div class="d-flex justify-content-between
                        align-items-start flex-wrap gap-3">

                <div>
                    <h3 class="fw-bold mb-2">
                        @Model.FullName
                    </h3>

                    <p class="text-muted mb-0">
                        Patient Number:
                        <strong>@Model.PatientNumber</strong>
                    </p>
                </div>

                <span class="badge bg-success">
                    @(Model.IsArchived ? "Archived" : "Active")
                </span>

            </div>

        </div>
    </div>

    @* Personal Information *@

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-4">
                Personal Information
            </h5>

            <div class="row g-4">

                <div class="col-md-6">
                    <div class="text-muted small">
                        Full Name
                    </div>
                    <div class="fw-semibold">
                        @Model.FullName
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small">
                        Date of Birth
                    </div>
                    <div class="fw-semibold">
                        @Model.DateOfBirth.ToString("yyyy-MM-dd")
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small">
                        Gender
                    </div>
                    <div class="fw-semibold">
                        @(Model.Gender ?? "Not provided")
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small">
                        Phone Number
                    </div>
                    <div class="fw-semibold">
                        @(Model.PhoneNumber ?? "Not provided")
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small">
                        Email Address
                    </div>
                    <div class="fw-semibold">
                        @(Model.Email ?? "Not provided")
                    </div>
                </div>

                <div class="col-12">
                    <div class="text-muted small">
                        Address
                    </div>
                    <div class="fw-semibold">
                        @(Model.Address ?? "Not provided")
                    </div>
                </div>

            </div>

        </div>
    </div>

    @* Emergency Contact *@

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-4">
                Emergency Contact
            </h5>

            <div class="row g-4">

                <div class="col-md-6">
                    <div class="text-muted small">
                        Contact Name
                    </div>
                    <div class="fw-semibold">
                        @(Model.EmergencyContactName
                          ?? "Not provided")
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small">
                        Contact Phone
                    </div>
                    <div class="fw-semibold">
                        @(Model.EmergencyContactPhone
                          ?? "Not provided")
                    </div>
                </div>

            </div>

        </div>
    </div>

    @* Medical History — Future EMR Integration *@

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">
                Medical History
            </h5>

            <div class="alert alert-info mb-0">

                <strong>
                    Clinical access is restricted
                </strong>

                <p class="mb-0 mt-2">
                    Authorized treating doctors access medical history through
                    Medical Records or their linked appointments. Patient administration
                    permissions do not grant access to clinical information.
                </p>

            </div>

        </div>
    </div>

    @* Registration Information *@

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-4">
                Record Information
            </h5>

            <div class="row g-4">

                <div class="col-md-6">
                    <div class="text-muted small">
                        Registered At (UTC)
                    </div>
                    <div class="fw-semibold">
                        @Model.CreatedAtUtc.ToString(
                            "yyyy-MM-dd HH:mm")
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted small">
                        Last Updated (UTC)
                    </div>
                    <div class="fw-semibold">
                        @Model.UpdatedAtUtc.ToString(
                            "yyyy-MM-dd HH:mm")
                    </div>
                </div>

            </div>

        </div>
    </div>

</div>
