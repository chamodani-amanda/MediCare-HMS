@model MediCare.Web.ViewModels.FacilityForm
@{ViewData["Title"]=Model.IsBed?"Bed Details":"Ward Details";}
<div class="py-4"><h1>@ViewData["Title"]</h1><form method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" /><div class="mb-3"><label asp-for="Code" class="form-label">@(Model.IsBed?"Bed number":"Ward code")</label><input asp-for="Code" maxlength="40" required class="form-control" /></div>
@if(Model.IsBed){<div class="mb-3"><label asp-for="WardId" class="form-label">Ward</label><select asp-for="WardId" class="form-select"><option value="">Select ward</option>@foreach(var w in Model.Wards){<option value="@w.Id">@w.Code — @w.Name</option>}</select></div>}else{<div class="mb-3"><label asp-for="Name" class="form-label">Ward name</label><input asp-for="Name" maxlength="120" required class="form-control" /></div><div class="mb-3"><label asp-for="DepartmentId" class="form-label">Department</label><select asp-for="DepartmentId" class="form-select"><option value="">Select department</option>@foreach(var d in Model.Departments){<option value="@d.Id">@d.Name</option>}</select></div>}
<div class="form-check mb-3"><input asp-for="Active" class="form-check-input" /><label asp-for="Active" class="form-check-label">@(Model.IsBed?"Operational":"Active")</label></div><p class="form-text">Codes and assignments are permanent. Occupied beds/wards cannot be deactivated. History cannot be deleted.</p><button class="btn btn-primary">Save</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form></div>
