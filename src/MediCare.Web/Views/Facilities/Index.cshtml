@model MediCare.Web.ViewModels.CarePage<MediCare.Web.ViewModels.WardSummary>
@{ViewData["Title"]="Wards and Bed Availability";}
<div class="py-4"><h1>Wards and Bed Availability</h1><p class="text-muted">Aggregate occupancy only. Ward administration does not grant access to patient or clinical records.</p><a asp-action="Ward" class="btn btn-primary mb-3">Register ward</a><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Ward</th><th>Department</th><th>Status</th><th>Operational</th><th>Occupied</th><th>Available</th><th></th></tr></thead><tbody>@foreach(var r in Model.Rows){<tr><td>@r.Ward.Code — @r.Ward.Name</td><td>@r.Ward.Department.Name</td><td>@(r.Ward.IsActive?"Active":"Inactive")</td><td>@r.OperationalBeds</td><td>@r.OccupiedBeds</td><td>@r.AvailableBeds</td><td><a asp-action="Ward" asp-route-id="@r.Ward.Id">Edit</a> · <a asp-action="Beds" asp-route-wardId="@r.Ward.Id">Beds</a></td></tr>}</tbody></table></div><p>Page @Model.Page of @Model.Pages</p>@if(Model.Page>1){<a asp-route-page="@(Model.Page-1)">Previous</a>} @if(Model.Page<Model.Pages){<a asp-route-page="@(Model.Page+1)">Next</a>}</div>
