@model MediCare.Web.ViewModels.CarePage<MediCare.Web.ViewModels.FacilityForm>
@{ViewData["Title"]="Ward Beds";}
<div class="py-4"><h1>Ward Beds</h1><a asp-action="Bed" asp-route-wardId="@ViewBag.WardId" class="btn btn-primary mb-3">Register bed</a><div class="table-responsive"><table class="table"><thead><tr><th>Bed number</th><th>Operational status</th><th></th></tr></thead><tbody>@foreach(var b in Model.Rows){<tr><td>@b.Code</td><td>@(b.Active?"Operational":"Out of service")</td><td><a asp-action="Bed" asp-route-id="@b.Id">Edit</a></td></tr>}</tbody></table></div><p>Page @Model.Page of @Model.Pages</p>@if(Model.Page>1){<a asp-route-page="@(Model.Page-1)" asp-route-wardId="@ViewBag.WardId">Previous</a>} @if(Model.Page<Model.Pages){<a asp-route-page="@(Model.Page+1)" asp-route-wardId="@ViewBag.WardId">Next</a>} <a asp-action="Index">Back to wards</a></div>
