@model MediCare.Web.ViewModels.DoctorScheduleFormViewModel
@{ bool editing = Model.Id != Guid.Empty; ViewData["Title"] = editing ? "Edit Working Schedule" : "Add Working Schedule"; }
<div class="py-4"><h1 class="fw-bold mb-4">@ViewData["Title"]</h1>
<div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4">
    <p>Weekly schedule in Sri Lanka time (Asia/Colombo). End time must follow start time on the same day. Split overnight shifts across two days.</p>
    <form asp-action="@(editing ? "Edit" : "Create")" method="post">
        <input asp-for="Id" type="hidden" /><input asp-for="DoctorId" type="hidden" /><input asp-for="Version" type="hidden" /><input asp-for="DoctorVersion" type="hidden" />
        <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
        <div class="row g-3">
            <div class="col-md-4"><label asp-for="DayOfWeek" class="form-label"></label><select asp-for="DayOfWeek" asp-items="Html.GetEnumSelectList<DayOfWeek>()" class="form-select"></select></div>
            <div class="col-md-4"><label asp-for="StartTime" class="form-label"></label><input asp-for="StartTime" asp-format="{0:HH:mm}" type="time" class="form-control" /><span asp-validation-for="StartTime" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="EndTime" class="form-label"></label><input asp-for="EndTime" asp-format="{0:HH:mm}" type="time" class="form-control" /><span asp-validation-for="EndTime" class="text-danger"></span></div>
            <div class="col-12 form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
        </div>
        <p class="form-text">Deactivate a schedule to retain it without publishing availability.</p>
        <div class="d-flex justify-content-end gap-2 mt-4"><a asp-action="Index" asp-route-doctorId="@Model.DoctorId" class="btn btn-outline-secondary">Cancel</a><button class="btn btn-primary" type="submit">Save Schedule</button></div>
    </form>
</div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
