@model MediCare.Web.ViewModels.SecurityAuditLogListViewModel

@{
    ViewData["Title"] = "Security Audit Logs";
}

<div class="py-4">

    <div class="mb-4">
        <h1 class="fw-bold">Security Audit Logs</h1>

        <p class="text-muted">
            Review staff account, patient, document, doctor, department, schedule, appointment and medical-record activities.
            Laboratory and clinical audit events contain identifiers and action names, not clinical content.
        </p>
    </div>

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between
                        align-items-center flex-wrap gap-2 mb-4">

                <h5 class="fw-bold mb-0">
                    Activity History
                </h5>

                <span class="badge bg-primary">
                    Total: @Model.TotalRecords
                </span>
            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Action</th>
                            <th>Performed By</th>
                            <th>Target Account / Record ID</th>
                            <th>Result</th>
                            <th>Date and Time (UTC)</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var record in Model.Records)
                        {
                            <tr>
                                <td>
                                    <span class="fw-semibold">
                                        @record.Action
                                    </span>
                                </td>

                                <td>@record.ActorEmail</td>

                                <td>@record.TargetEmail</td>

                                <td>
                                    @if (record.Succeeded)
                                    {
                                        <span class="badge bg-success">
                                            Success
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Failed
                                        </span>
                                    }
                                </td>

                                <td>
                                    @record.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm:ss")
                                </td>
                            </tr>
                        }

                        @if (Model.Records.Count == 0)
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center text-muted py-4">
                                    No security audit records found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-between
                            align-items-center mt-3">

                    <span class="text-muted small">
                        Page @Model.Page of @Model.TotalPages
                    </span>

                    <div class="d-flex gap-2">

                        @if (Model.Page > 1)
                        {
                            <a asp-action="Index"
                               asp-route-page="@(Model.Page - 1)"
                               class="btn btn-outline-secondary btn-sm">
                                Previous
                            </a>
                        }

                        @if (Model.Page < Model.TotalPages)
                        {
                            <a asp-action="Index"
                               asp-route-page="@(Model.Page + 1)"
                               class="btn btn-outline-primary btn-sm">
                                Next
                            </a>
                        }

                    </div>
                </div>
            }

        </div>
    </div>

</div>
