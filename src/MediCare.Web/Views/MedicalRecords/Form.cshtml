@model MediCare.Web.ViewModels.MedicalRecordForm
@{ ViewData["Title"] = Model.Id == Guid.Empty ? "New Consultation" : "Edit Clinical Draft"; }
<div class="py-4">
    <h1 class="fw-bold">@ViewData["Title"]</h1><p class="text-muted">@Model.PatientLabel · Draft changes are private until finalized.</p>
    <form asp-action="@(Model.Id == Guid.Empty ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <input asp-for="Id" type="hidden" /><input asp-for="AppointmentId" type="hidden" /><input asp-for="CreationToken" type="hidden" /><input asp-for="Version" type="hidden" />
        @if (Model.IsAmendment)
        { <div class="mb-3"><label asp-for="AmendmentReason" class="form-label">Amendment reason</label><textarea asp-for="AmendmentReason" maxlength="1000" required class="form-control" rows="2"></textarea></div> }
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="Symptoms" class="form-label"></label><textarea asp-for="Symptoms" maxlength="4000" class="form-control" rows="5"></textarea></div>
            <div class="col-md-6"><label asp-for="Observations" class="form-label">Clinical observations</label><textarea asp-for="Observations" maxlength="8000" class="form-control" rows="5"></textarea></div>
            <div class="col-md-6"><label asp-for="Diagnosis" class="form-label"></label><textarea asp-for="Diagnosis" maxlength="4000" class="form-control" rows="5"></textarea></div>
            <div class="col-md-6"><label asp-for="Treatment" class="form-label">Treatment notes</label><textarea asp-for="Treatment" maxlength="8000" class="form-control" rows="5"></textarea></div>
        </div>
        <h2 class="h4 mt-4">Prescriptions</h2><p class="text-muted">Leave unused rows blank. Each entered prescription requires all fields except instructions. No dispensing is performed.</p>
        @for (var i = 0; i < Model.Prescriptions.Count; i++)
        {
            <details class="card card-body mb-2" open="@(i == 0 || !Model.Prescriptions[i].IsEmpty)">
                <summary>Prescription @(i+1)</summary>
                <div class="row g-2 mt-1">
                    <input asp-for="Prescriptions[i].SourceId" type="hidden" />
                    <div class="col-12"><label asp-for="Prescriptions[i].MedicineId" class="form-label">Exact inventory medicine</label><select asp-for="Prescriptions[i].MedicineId" class="form-select"><option value="">Free-text only — cannot be dispensed</option>@foreach(var medicine in Model.Medicines) { <option value="@medicine.Id">@medicine.Label</option> }</select></div>
                    <div class="col-md-6"><label asp-for="Prescriptions[i].AuthorizedQuantity" class="form-label">Authorized total quantity (includes prior dispensing)</label><input asp-for="Prescriptions[i].AuthorizedQuantity" type="number" min="0.001" max="1000000000" step="0.001" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="Prescriptions[i].DispensingUnit" class="form-label">Exact catalogue dispensing unit</label><input asp-for="Prescriptions[i].DispensingUnit" maxlength="60" class="form-control" /></div>
                    <div class="col-12 form-check"><input asp-for="Prescriptions[i].ConfirmAuthorizationChange" class="form-check-input" /><label asp-for="Prescriptions[i].ConfirmAuthorizationChange" class="form-check-label">I explicitly authorize the changed medicine or increased total quantity.</label></div>
                    <div class="col-md-6"><label asp-for="Prescriptions[i].Medication" class="form-label">Medication</label><input asp-for="Prescriptions[i].Medication" maxlength="200" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="Prescriptions[i].Dosage" class="form-label">Dosage</label><input asp-for="Prescriptions[i].Dosage" maxlength="100" class="form-control" /></div>
                    <div class="col-md-4"><label asp-for="Prescriptions[i].Route" class="form-label">Route</label><input asp-for="Prescriptions[i].Route" maxlength="100" class="form-control" /></div>
                    <div class="col-md-4"><label asp-for="Prescriptions[i].Frequency" class="form-label">Frequency</label><input asp-for="Prescriptions[i].Frequency" maxlength="200" class="form-control" /></div>
                    <div class="col-md-4"><label asp-for="Prescriptions[i].Duration" class="form-label">Duration</label><input asp-for="Prescriptions[i].Duration" maxlength="200" class="form-control" /></div>
                    <div class="col-12"><label asp-for="Prescriptions[i].Instructions" class="form-label">Instructions</label><textarea asp-for="Prescriptions[i].Instructions" maxlength="1000" class="form-control" rows="2"></textarea></div>
                </div>
            </details>
        }
        <div class="d-flex gap-2 mt-4"><button class="btn btn-primary" type="submit">Save Draft</button><a asp-action="Index" class="btn btn-outline-secondary">Back to Records</a></div>
    </form>
</div>
