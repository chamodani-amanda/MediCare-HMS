@model MediCare.Web.ViewModels.MedicalRecordDetails
@{ ViewData["Title"] = "Medical Consultation"; var r = Model.Revision; }
<div class="py-4">
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a asp-action="Index" asp-route-patientId="@r.MedicalRecord.PatientId" class="btn btn-outline-secondary">Patient Medical History</a>
        <a asp-action="Details" asp-route-id="@r.Id" asp-route-print="true" class="btn btn-outline-primary">Printable Report</a>
        <a asp-action="Pdf" asp-route-id="@r.Id" class="btn btn-outline-primary">Download PDF (Latin script)</a>
    </div>
    <partial name="_Report" model="Model" />
    <div class="d-flex flex-wrap gap-2 mb-3"><a asp-controller="Laboratory" asp-action="Index" asp-route-patientId="@r.MedicalRecord.PatientId" class="btn btn-outline-primary">Patient Laboratory History</a>
    @if (Model.CanWrite) {<a asp-controller="Laboratory" asp-action="Create" asp-route-medicalRecordId="@r.MedicalRecordId" class="btn btn-outline-primary">Request Laboratory Investigation</a>}
    </div>
    <p class="small text-muted">For Sinhala, Tamil or other scripts, use Printable Report and your browser's Save as PDF.</p>
    @if (Model.CanWrite && !r.FinalizedAtUtc.HasValue)
    {
        <div class="d-flex flex-wrap align-items-center gap-3 mb-4"><a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-primary">Edit Draft</a>
        <form asp-action="Finalize" asp-route-id="@r.Id" method="post"><input name="version" type="hidden" value="@r.Version" /><button class="btn btn-success">Finalize Record</button></form></div>
        <p class="text-muted">Finalization locks this revision. Later corrections require a new amendment with a reason.</p>
    }
    @if (Model.CanWrite && Model.IsLatest && r.FinalizedAtUtc.HasValue)
    {
        <form asp-action="Amend" asp-route-id="@r.Id" method="post" class="card card-body mb-4">
            <input name="version" type="hidden" value="@r.Version" />
            <label for="reason" class="form-label">Reason for amendment</label><textarea id="reason" name="reason" maxlength="1000" required class="form-control mb-2" rows="2"></textarea>
            <button class="btn btn-outline-primary align-self-start">Start Amendment Draft</button>
        </form>
    }
    <h2 class="h4">Encounter revision history</h2><ul>
    @foreach (var item in Model.History)
    { <li><a asp-action="Details" asp-route-id="@item.Id">Revision @item.Number — @(item.FinalizedAtUtc.HasValue ? "Finalized" : "Draft")</a></li> }
    </ul>
</div>
