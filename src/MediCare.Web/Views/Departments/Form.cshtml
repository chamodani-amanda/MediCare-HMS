@model MediCare.Web.ViewModels.DepartmentFormViewModel
@{ bool editing = Model.Id != Guid.Empty; ViewData["Title"] = editing ? "Edit Department" : "Add Department"; }
<div class="py-4"><h1 class="fw-bold mb-4">@ViewData["Title"]</h1>
<div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4">
    <form asp-action="@(editing ? "Edit" : "Create")" method="post">
        <input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" />
        <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
        <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" rows="3" class="form-control"></textarea></div>
        <div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Active department</label></div>
        <p class="text-muted">Active doctors must be moved or deactivated before deactivating their department.</p>
        <div class="d-flex justify-content-end gap-2"><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a><button class="btn btn-primary" type="submit">Save Department</button></div>
    </form>
</div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
