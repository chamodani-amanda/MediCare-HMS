@model MediCare.Web.ViewModels.LabCatalogueList
@{ ViewData["Title"]="Laboratory Test Catalogue"; }
<div class="py-4">
<div class="d-flex justify-content-between flex-wrap gap-3 mb-4"><h1 class="fw-bold">Laboratory Test Catalogue</h1><a asp-action="Create" class="btn btn-primary">Add Test</a></div>
<form method="get" class="row g-3 mb-4"><div class="col-md-6"><label asp-for="Search" class="form-label">Code, name or category</label><input asp-for="Search" maxlength="100" class="form-control" /></div><div class="col-md-4 align-self-end"><label><input asp-for="IncludeInactive" /> Include inactive tests</label></div><div class="col-md-2 align-self-end"><button class="btn btn-primary">Search</button></div></form>
<p>@Model.Total test(s)</p><div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Code</th><th>Name</th><th>Category</th><th>Sample</th><th>Format / unit</th><th>Status</th><th></th></tr></thead><tbody>
@foreach(var t in Model.Tests){<tr><td>@t.Code</td><td>@t.Name</td><td>@t.Category</td><td>@t.SampleType</td><td>@t.ResultKind @t.Unit</td><td>@(t.IsActive?"Active":"Inactive")</td><td><a asp-action="Edit" asp-route-id="@t.Id">Edit</a></td></tr>}
</tbody></table></div><nav class="d-flex gap-3" aria-label="Catalogue pages">
@if(Model.Page>1){<a asp-action="Index" asp-route-search="@Model.Search" asp-route-includeInactive="@Model.IncludeInactive" asp-route-page="@(Model.Page-1)">Previous</a>}<span>Page @Model.Page of @Model.TotalPages</span>
@if(Model.Page<Model.TotalPages){<a asp-action="Index" asp-route-search="@Model.Search" asp-route-includeInactive="@Model.IncludeInactive" asp-route-page="@(Model.Page+1)">Next</a>}
</nav></div>
